diff --git a/fs/file_capability.c b/fs/file_capability.c
new file mode 100644
index 0000000000000000000000000000000000000000..30ff5fff34330b36cd47bebc358d1701f75dd3bb
--- /dev/null
+++ b/fs/file_capability.c
@@ -0,0 +1,344 @@
+// SPDX-License-Identifier: GPL-2.0
+/* Monotonic regular-file capability derivation for the authority PoC. */
+#include <linux/atomic.h>
+#include <linux/bitops.h>
+#include <linux/compat.h>
+#include <linux/file.h>
+#include <linux/file_capability.h>
+#include <linux/fcntl.h>
+#include <linux/fs.h>
+#include <linux/mutex.h>
+#include <linux/security.h>
+#include <linux/slab.h>
+#include <linux/uaccess.h>
+
+struct file_capability {
+	u32 nbits;
+	atomic_long_t rights[];
+};
+
+static unsigned long file_mode_rights(const struct file *file)
+{
+	unsigned long rights = 0;
+
+	if (file->f_mode & FMODE_READ)
+		rights |= BIT(FILE_CAP_READ);
+	if (file->f_mode & FMODE_WRITE)
+		rights |= BIT(FILE_CAP_WRITE);
+	return rights;
+}
+
+bool file_cap_supported(const struct file *file)
+{
+	const char *name;
+
+	if (!file || !file->f_inode || !S_ISREG(file->f_inode->i_mode) ||
+	    IS_ANON_FILE(file->f_inode) ||
+	    (file->f_mode & (FMODE_PATH | FMODE_BACKING)))
+		return false;
+
+	name = file->f_inode->i_sb->s_type->name;
+	/* These generic filesystems have audited, re-entrant regular-file opens. */
+	return !strcmp(name, "rootfs") || !strcmp(name, "ramfs") ||
+	       !strcmp(name, "tmpfs");
+}
+
+bool file_cap_managed(const struct file *file)
+{
+	return file && READ_ONCE(file->f_capability) != NULL;
+}
+
+unsigned long file_cap_rights(const struct file *file)
+{
+	struct file_capability *cap;
+
+	cap = READ_ONCE(file->f_capability);
+	if (!cap)
+		return file_mode_rights(file);
+	return (unsigned long)atomic_long_read(&cap->rights[0]) &
+		GENMASK(FILE_CAP_NR_RIGHTS - 1, 0);
+}
+
+bool file_cap_has(const struct file *file, unsigned int right)
+{
+	if (right >= FILE_CAP_NR_RIGHTS)
+		return false;
+	return file_cap_rights(file) & BIT(right);
+}
+
+static struct file_capability *file_cap_alloc(unsigned long rights)
+{
+	struct file_capability *cap;
+
+	cap = kzalloc(struct_size(cap, rights, 1), GFP_KERNEL);
+	if (!cap)
+		return NULL;
+	cap->nbits = FILE_CAP_NR_RIGHTS;
+	atomic_long_set(&cap->rights[0],
+			rights & GENMASK(FILE_CAP_NR_RIGHTS - 1, 0));
+	return cap;
+}
+
+int file_cap_restrict(struct file *file, unsigned long mask)
+{
+	struct file_capability *cap, *new;
+	unsigned long current_rights, reduced;
+
+	if (!file_cap_supported(file))
+		return -EOPNOTSUPP;
+	mask &= GENMASK(FILE_CAP_NR_RIGHTS - 1, 0);
+	current_rights = file_cap_rights(file);
+	reduced = current_rights & mask;
+	if (reduced == current_rights)
+		return 0;
+
+	cap = READ_ONCE(file->f_capability);
+	if (cap) {
+		atomic_long_fetch_and(mask, &cap->rights[0]);
+		return 0;
+	}
+
+	new = file_cap_alloc(reduced);
+	if (!new)
+		return -ENOMEM;
+	cap = cmpxchg(&file->f_capability, NULL, new);
+	if (cap) {
+		kfree(new);
+		atomic_long_fetch_and(mask, &cap->rights[0]);
+	}
+	return 0;
+}
+
+void file_cap_free(struct file *file)
+{
+	kfree(file->f_capability);
+	file->f_capability = NULL;
+}
+
+static int validate_bitmap(const u8 *bitmap, size_t bytes)
+{
+	size_t i;
+
+	if (bitmap[0] & ~GENMASK(FILE_CAP_NR_RIGHTS - 1, 0))
+		return -EOPNOTSUPP;
+	for (i = 1; i < bytes; i++)
+		if (bitmap[i])
+			return -EOPNOTSUPP;
+	return 0;
+}
+
+static int read_request(unsigned long arg, struct fd_cap_request *header,
+			 u8 **bitmap, size_t *bitmap_size)
+{
+	struct fd_cap_request __user *request = (void __user *)arg;
+
+	if (copy_from_user(header, request, sizeof(*header)))
+		return -EFAULT;
+	if (header->version != FD_CAP_VERSION_1 ||
+	    header->size < sizeof(*header) + 1)
+		return -EINVAL;
+	if (header->size > PAGE_SIZE)
+		return -E2BIG;
+	*bitmap_size = header->size - sizeof(*header);
+	*bitmap = memdup_user(request->rights, *bitmap_size);
+	if (IS_ERR(*bitmap)) {
+		int error = PTR_ERR(*bitmap);
+
+		*bitmap = NULL;
+		return error;
+	}
+	if (validate_bitmap(*bitmap, *bitmap_size)) {
+		kfree(*bitmap);
+		*bitmap = NULL;
+		return -EOPNOTSUPP;
+	}
+	return 0;
+}
+
+static long get_file_cap(unsigned long arg, struct file *file)
+{
+	struct fd_cap_request header;
+	struct fd_cap_request __user *request = (void __user *)arg;
+	u8 *bitmap;
+	size_t bytes;
+	unsigned long rights;
+	int error;
+
+	if (!file_cap_supported(file))
+		return -EOPNOTSUPP;
+	if (copy_from_user(&header, request, sizeof(header)))
+		return -EFAULT;
+	if (header.version != FD_CAP_VERSION_1 || header.flags ||
+	    header.size < sizeof(header) + 1)
+		return -EINVAL;
+	if (header.size > PAGE_SIZE)
+		return -E2BIG;
+	bytes = header.size - sizeof(header);
+	bitmap = kzalloc(bytes, GFP_KERNEL);
+	if (!bitmap)
+		return -ENOMEM;
+	rights = file_cap_rights(file);
+	if (rights & BIT(FILE_CAP_READ))
+		bitmap[FD_CAP_READ / 8] |= BIT(FD_CAP_READ % 8);
+	if (rights & BIT(FILE_CAP_WRITE))
+		bitmap[FD_CAP_WRITE / 8] |= BIT(FD_CAP_WRITE % 8);
+	error = copy_to_user(request->rights, bitmap, bytes) ? -EFAULT : 0;
+	if (!error)
+		error = copy_to_user(request, &header, sizeof(header)) ?
+			-EFAULT : 0;
+	kfree(bitmap);
+	return error;
+}
+
+static int clone_open_flags(const struct file *source, unsigned int source_flags,
+			    unsigned long rights)
+{
+	unsigned int flags;
+
+	/* Preserve source behavior flags; never reproduce open-time actions. */
+	flags = source_flags & ~(O_ACCMODE | O_CLOEXEC | O_CREAT | O_EXCL |
+				    O_TRUNC | O_NOCTTY | O_PATH | O_DIRECTORY |
+				    O_TMPFILE | __O_TMPFILE | __O_REGULAR);
+	if (rights & BIT(FILE_CAP_READ)) {
+		if (rights & BIT(FILE_CAP_WRITE))
+			flags |= O_RDWR;
+		else
+			flags |= O_RDONLY;
+	} else if (rights & BIT(FILE_CAP_WRITE)) {
+		flags |= O_WRONLY;
+	} else if (file_mode_rights(source) & BIT(FILE_CAP_WRITE)) {
+		/* Keep a zero-right clone no more open than its write-only source. */
+		flags |= O_WRONLY;
+	} else {
+		flags |= O_RDONLY;
+	}
+	return flags;
+}
+
+static long clone_file_cap(unsigned int source_fd, unsigned long arg,
+			   struct file *source)
+{
+	struct fd_cap_request header;
+	struct file *clone;
+	struct file_capability *cap;
+	u8 *bitmap;
+	size_t bytes;
+	unsigned long requested = 0, child_rights;
+	unsigned int open_flags, source_flags, fd_flags = 0;
+	int error, fd, post_mask = 0;
+
+	if (!file_cap_supported(source))
+		return -EOPNOTSUPP;
+	spin_lock(&source->f_lock);
+	source_flags = source->f_flags;
+	spin_unlock(&source->f_lock);
+	if ((source_flags & FASYNC) || file_f_owner(source))
+		return -EOPNOTSUPP;
+	error = read_request(arg, &header, &bitmap, &bytes);
+	if (error)
+		return error;
+	if (header.flags & ~FD_CAP_F_CLOEXEC) {
+		error = -EINVAL;
+		goto out_bitmap;
+	}
+	if (header.flags & FD_CAP_F_CLOEXEC)
+		fd_flags = O_CLOEXEC;
+	if (bitmap[FD_CAP_READ / 8] & BIT(FD_CAP_READ % 8))
+		requested |= BIT(FILE_CAP_READ);
+	if (bitmap[FD_CAP_WRITE / 8] & BIT(FD_CAP_WRITE % 8))
+		requested |= BIT(FILE_CAP_WRITE);
+	child_rights = file_cap_rights(source) & requested;
+	open_flags = clone_open_flags(source, source_flags, child_rights);
+
+	/* Preserve the LSM inode-open decision without repeating generic DAC. */
+	post_mask = MAY_OPEN;
+	if (child_rights & BIT(FILE_CAP_READ))
+		post_mask |= MAY_READ;
+	if (child_rights & BIT(FILE_CAP_WRITE))
+		post_mask |= MAY_WRITE;
+	error = security_inode_permission(source->f_inode, post_mask);
+	if (error)
+		goto out_bitmap;
+
+	/* Reinstantiate from the pinned path, never by pathname or procfs. */
+	clone = dentry_open(&source->f_path, open_flags, source->f_cred);
+	if (IS_ERR(clone)) {
+		error = PTR_ERR(clone);
+		goto out_bitmap;
+	}
+	if (clone->f_mode & FMODE_READ)
+		post_mask |= MAY_READ;
+	if (clone->f_mode & FMODE_WRITE)
+		post_mask |= MAY_WRITE;
+	error = security_file_post_open(clone, post_mask);
+	if (error)
+		goto out_clone;
+	error = security_file_clone(source, clone);
+	if (error)
+		goto out_clone;
+
+	/* A fresh file description gets its own offset and filesystem state. */
+	mutex_lock(&source->f_pos_lock);
+	clone->f_pos = source->f_pos;
+	mutex_unlock(&source->f_pos_lock);
+	child_rights &= file_mode_rights(clone);
+	cap = file_cap_alloc(child_rights);
+	if (!cap) {
+		error = -ENOMEM;
+		goto out_clone;
+	}
+	WRITE_ONCE(clone->f_capability, cap);
+
+	fd = get_unused_fd_flags(fd_flags);
+	if (fd < 0) {
+		error = fd;
+		goto out_clone;
+	}
+	fd_install(fd, clone);
+	error = fd;
+	goto out_bitmap;
+
+out_clone:
+	fput(clone);
+out_bitmap:
+	kfree(bitmap);
+	return error;
+}
+
+long file_cap_fcntl(unsigned int fd, struct file *file,
+		    unsigned int cmd, unsigned long arg)
+{
+	struct fd_cap_request header;
+	u8 *bitmap;
+	size_t bytes;
+	unsigned long mask = 0;
+	int error;
+
+	switch (cmd) {
+	case F_GETFD_CAP:
+		return get_file_cap(arg, file);
+	case F_RESTRICTFD_CAP:
+		if (!file_cap_supported(file))
+			return -EOPNOTSUPP;
+		error = read_request(arg, &header, &bitmap, &bytes);
+		if (error)
+			return error;
+		if (header.flags) {
+			error = -EINVAL;
+			goto out;
+		}
+		if (bitmap[FD_CAP_READ / 8] & BIT(FD_CAP_READ % 8))
+			mask |= BIT(FILE_CAP_READ);
+		if (bitmap[FD_CAP_WRITE / 8] & BIT(FD_CAP_WRITE % 8))
+			mask |= BIT(FILE_CAP_WRITE);
+		error = file_cap_restrict(file, mask);
+		goto out;
+	case F_CLONEFD_CAP:
+		return clone_file_cap(fd, arg, file);
+	default:
+		return -EINVAL;
+	}
+out:
+	kfree(bitmap);
+	return error;
+}
