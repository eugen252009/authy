+static int apparmor_file_clone(const struct file *source, struct file *file)
+{
+	struct aa_file_ctx *src = file_ctx(source);
+	struct aa_file_ctx *dst = file_ctx(file);
+	struct aa_label *label, *old;
+	u32 allow;
+
+	/*
+	 * The open hooks used saved opener credentials, whereas allocation
+	 * initialized dst with the current label. Keep cached grants tied to
+	 * the source's validated label, never to that unrelated current label.
+	 * Snapshot only AppArmor-owned state, holding an independent label ref.
+	 */
+	spin_lock(&src->lock);
+	label = aa_get_label(rcu_dereference_protected(src->label,
+					      lockdep_is_held(&src->lock)));
+	allow = src->allow;
+	spin_unlock(&src->lock);
+
+	/* The destination is private until the clone operation publishes it. */
+	old = rcu_access_pointer(dst->label);
+	rcu_assign_pointer(dst->label, label);
+	dst->allow &= allow;
+	aa_put_label(old);
+	return 0;
+}
