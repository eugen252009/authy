+/* SPDX-License-Identifier: GPL-2.0 */
+#ifndef _LINUX_FILE_CAPABILITY_H
+#define _LINUX_FILE_CAPABILITY_H
+
+#include <linux/types.h>
+
+struct file;
+
+#define FILE_CAP_READ	0
+#define FILE_CAP_WRITE	1
+#define FILE_CAP_NR_RIGHTS 2
+
+bool file_cap_supported(const struct file *file);
+bool file_cap_managed(const struct file *file);
+bool file_cap_has(const struct file *file, unsigned int right);
+unsigned long file_cap_rights(const struct file *file);
+int file_cap_restrict(struct file *file, unsigned long mask);
+long file_cap_fcntl(unsigned int fd, struct file *file,
+		    unsigned int cmd, unsigned long arg);
+void file_cap_free(struct file *file);
+
+#endif /* _LINUX_FILE_CAPABILITY_H */
