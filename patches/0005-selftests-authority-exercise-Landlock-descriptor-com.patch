From f30167893ba5a00e4bdcaf4ff4def6392adbed6b Mon Sep 17 00:00:00 2001
From: Eugen <eugen252009@gmail.com>
Date: Sat, 17 Oct 2026 10:22:49 +0200
Subject: [PATCH 5/9] selftests: authority: exercise Landlock descriptor
 composition

Record the qualified Landlock/FD composition and independent-denial regression source.
---
 .../selftests/authority/landlock_fd_test.c    | 491 ++++++++++++++++++
 1 file changed, 491 insertions(+)
 create mode 100644 tools/testing/selftests/authority/landlock_fd_test.c

diff --git a/tools/testing/selftests/authority/landlock_fd_test.c b/tools/testing/selftests/authority/landlock_fd_test.c
new file mode 100644
index 0000000000000000000000000000000000000000..c595c1656966c513f0ab2b6a8c5074cbb9247b11
--- /dev/null
+++ b/tools/testing/selftests/authority/landlock_fd_test.c
@@ -0,0 +1,491 @@
+// SPDX-License-Identifier: GPL-2.0
+#define _GNU_SOURCE
+#include <errno.h>
+#include <fcntl.h>
+#define _ASM_GENERIC_FCNTL_H
+#define F_LINUX_SPECIFIC_BASE 1024
+#include <linux/fcntl.h>
+#include <linux/fs.h>
+#include <linux/landlock.h>
+#include <linux/prctl.h>
+#include <stdint.h>
+#include <stdio.h>
+#include <stdlib.h>
+#include <string.h>
+#include <sys/fsuid.h>
+#include <sys/ioctl.h>
+#include <sys/prctl.h>
+#include <sys/socket.h>
+#include <sys/stat.h>
+#include <sys/syscall.h>
+#include <sys/wait.h>
+#include <unistd.h>
+#include "../kselftest.h"
+
+#ifndef ENABLE_AUTHORITY
+#define ENABLE_AUTHORITY 1
+#endif
+#define RW (LANDLOCK_ACCESS_FS_READ_FILE | LANDLOCK_ACCESS_FS_WRITE_FILE)
+#define LL_MASK (RW | LANDLOCK_ACCESS_FS_READ_DIR | LANDLOCK_ACCESS_FS_TRUNCATE | \
+		 LANDLOCK_ACCESS_FS_IOCTL_DEV)
+#define ASSERT(x) do { if (!(x)) { \
+	dprintf(2, "# ASSERT %s:%d %s errno=%d\n", __func__, __LINE__, #x, errno); \
+	return 1; } } while (0)
+
+static int has_authority, ll_abi, rootfd, afd, bfd, source;
+static char *self;
+static char outside_path[] = "/tmp/authority-audit-outside-XXXXXX";
+
+static long result(const char *name, long ret)
+{
+	int error = ret < 0 ? errno : 0;
+
+	printf("# OBS op=%s ret=%ld errno=%d\n", name, ret, error);
+	errno = error;
+	return ret;
+}
+
+static int capop(int fd, int cmd, unsigned char mask)
+{
+	union {
+		uint64_t align;
+		unsigned char bytes[sizeof(struct fd_cap_request) + 1];
+	} s = {};
+	struct fd_cap_request *r = (void *)s.bytes;
+	int ret;
+
+	r->size = sizeof(s.bytes);
+	r->version = FD_CAP_VERSION_1;
+	r->rights[0] = mask;
+	ret = fcntl(fd, cmd, r);
+	return !ret && cmd == F_GETFD_CAP ? r->rights[0] : ret;
+}
+
+static int authority_enter(void)
+{
+	union {
+		uint64_t align;
+		unsigned char bytes[sizeof(struct pr_capauth_confine) + 1];
+	} s = {};
+	struct pr_capauth_confine *r = (void *)s.bytes;
+
+	if (!ENABLE_AUTHORITY || !has_authority)
+		return 0;
+	ASSERT(!prctl(PR_CAPAUTH, PR_CAPAUTH_ADD_FS_SCOPE,
+		      (unsigned long)rootfd, (unsigned long)PR_CAPAUTH_FS_READ_FILE, 0));
+	ASSERT(!prctl(PR_CAPAUTH, PR_CAPAUTH_ADD_FS_SCOPE,
+		      (unsigned long)rootfd, (unsigned long)PR_CAPAUTH_FS_WRITE_FILE, 0));
+	r->size = sizeof(s.bytes);
+	r->version = PR_CAPAUTH_CONFINE_VERSION_1;
+	r->handled[0] = (1U << PR_CAPAUTH_FS_READ_FILE) | (1U << PR_CAPAUTH_FS_WRITE_FILE);
+	ASSERT(!prctl(PR_CAPAUTH, PR_CAPAUTH_CONFINE, (unsigned long)r, 0, 0));
+	return 0;
+}
+
+static int add_rule(int ruleset, int fd, uint64_t allowed)
+{
+	struct landlock_path_beneath_attr rule = { .parent_fd = fd, .allowed_access = allowed };
+
+	return syscall(SYS_landlock_add_rule, ruleset, LANDLOCK_RULE_PATH_BENEATH, &rule, 0);
+}
+
+/* 0 empty deny-all; 1 RW in both dirs, TRUNCATE only in b; 2 TRUNCATE-only deny-all. */
+static int landlock_enter(int mode)
+{
+	struct landlock_ruleset_attr attr = {
+		.handled_access_fs = mode == 2 ? LANDLOCK_ACCESS_FS_TRUNCATE : LL_MASK,
+	};
+	int ruleset, device;
+
+	if (ll_abi < 0)
+		return 0;
+	ruleset = syscall(SYS_landlock_create_ruleset, &attr, sizeof(attr), 0);
+	ASSERT(ruleset >= 0);
+	if (mode != 2) {
+		int program = open(self, O_PATH);
+
+		ASSERT(program >= 0 && !add_rule(ruleset, program, LANDLOCK_ACCESS_FS_READ_FILE));
+		close(program);
+	}
+	if (mode == 1) {
+		ASSERT(!add_rule(ruleset, afd, RW | LANDLOCK_ACCESS_FS_READ_DIR));
+		ASSERT(!add_rule(ruleset, bfd, RW | LANDLOCK_ACCESS_FS_READ_DIR |
+				LANDLOCK_ACCESS_FS_TRUNCATE));
+		device = open("/dev/null", O_PATH);
+		ASSERT(device >= 0 && !add_rule(ruleset, device, RW));
+		close(device);
+	}
+	ASSERT(!prctl(PR_SET_NO_NEW_PRIVS, 1, 0, 0, 0));
+	ASSERT(!syscall(SYS_landlock_restrict_self, ruleset, 0));
+	close(ruleset);
+	return 0;
+}
+
+static int check_read(int fd)
+{
+	char c = 0;
+	ssize_t n = pread(fd, &c, 1, 0);
+
+	result("pread", n);
+	ASSERT(n == 1 && c == 'd');
+	return 0;
+}
+
+static int check_truncate(const char *label, int fd, int expected)
+{
+	int ret = result(label, ftruncate(fd, 4));
+
+	ASSERT(expected ? ret == -1 && errno == expected : ret == 0);
+	return 0;
+}
+
+static int transfer(int fd)
+{
+	int pair[2], out = -1;
+	char byte = 0;
+	union {
+		struct cmsghdr align;
+		char bytes[CMSG_SPACE(sizeof(int))];
+	} control = {};
+	struct iovec iov = { &byte, 1 };
+	struct msghdr msg = { .msg_iov = &iov, .msg_iovlen = 1,
+		.msg_control = control.bytes, .msg_controllen = sizeof(control.bytes) };
+	struct cmsghdr *cm = CMSG_FIRSTHDR(&msg);
+
+	if (socketpair(AF_UNIX, SOCK_STREAM, 0, pair))
+		return -1;
+	cm->cmsg_level = SOL_SOCKET;
+	cm->cmsg_type = SCM_RIGHTS;
+	cm->cmsg_len = CMSG_LEN(sizeof(int));
+	memcpy(CMSG_DATA(cm), &fd, sizeof(fd));
+	if (sendmsg(pair[0], &msg, 0) != 1 || recvmsg(pair[1], &msg, 0) != 1)
+		goto done;
+	cm = CMSG_FIRSTHDR(&msg);
+	if (cm && cm->cmsg_type == SCM_RIGHTS && !(msg.msg_flags & MSG_CTRUNC))
+		memcpy(&out, CMSG_DATA(cm), sizeof(out));
+done:
+	close(pair[0]);
+	close(pair[1]);
+	return out;
+}
+
+static int inherited(int fd, int expected)
+{
+	pid_t pid;
+	int status;
+
+	pid = fork();
+	ASSERT(pid >= 0);
+	if (!pid) {
+		char number[32], error[32];
+
+		snprintf(number, sizeof(number), "%d", fd);
+		snprintf(error, sizeof(error), "%d", expected);
+		execl(self, self, "--probe", number, error, NULL);
+		result("execve_failure", -1);
+		_exit(126);
+	}
+	ASSERT(waitpid(pid, &status, 0) == pid && WIFEXITED(status) && !WEXITSTATUS(status));
+	return 0;
+}
+
+static int preexisting(void)
+{
+	int alias, fdup, passed, clone, fd, rc, count = -1, dev;
+	uint64_t ignored;
+	char procpath[80];
+
+	dev = open("/dev/null", O_RDWR);
+	ASSERT(dev >= 0);
+	result("device_ioctl_pre", ioctl(dev, BLKGETSIZE64, &ignored));
+	ASSERT(!authority_enter() && !landlock_enter(0));
+	ASSERT(!check_read(source));
+	ASSERT(result("pre_pwrite", pwrite(source, "a", 1, 3)) == 1);
+	ASSERT(!check_truncate("pre_ftruncate", source, 0));
+	alias = result("dup_pre", dup(source));
+	fdup = result("fcntl_dupfd_pre", fcntl(source, F_DUPFD, 20));
+	passed = result("SCM_RIGHTS_pre", transfer(source));
+	ASSERT(alias >= 0 && fdup >= 0 && passed >= 0);
+	ASSERT(!check_read(alias) && !check_read(fdup) && !check_read(passed));
+	ASSERT(!check_truncate("SCM_ftruncate_pre", passed, 0));
+	ASSERT(!inherited(passed, 0));
+	result("device_ioctl_pre_after_landlock", ioctl(dev, BLKGETSIZE64, &ignored));
+	result("regular_ioctl_pre", ioctl(source, FIONREAD, &count));
+	fd = result("fresh_path_pre_case", openat(afd, "file", O_RDWR));
+	ASSERT(ll_abi >= 0 ? fd == -1 && errno == EACCES : fd >= 0);
+	if (fd >= 0)
+		close(fd);
+	fd = result("fresh_directory_pre_case", openat(rootfd, "a", O_RDONLY | O_DIRECTORY));
+	ASSERT(ll_abi >= 0 ? fd == -1 && errno == EACCES : fd >= 0);
+	if (fd >= 0)
+		close(fd);
+	if (!has_authority)
+		return 0;
+	ASSERT(lseek(source, 1, SEEK_SET) == 1);
+	clone = result("clone_pre_RW", capop(source, F_CLONEFD_CAP, 3));
+	ASSERT(clone >= 0 && capop(clone, F_GETFD_CAP, 0) == 3);
+	ASSERT(!check_read(clone) && !check_truncate("clone_pre_ftruncate", clone, 0));
+	ASSERT(lseek(source, 2, SEEK_SET) == 2 && lseek(clone, 0, SEEK_CUR) == 1);
+	ASSERT(lseek(alias, 0, SEEK_CUR) == 2);
+	printf("# OBS independent_clone_offset=1 shared_dup_offset=2\n");
+	fd = result("fresh_path_after_clone", openat(afd, "file", O_RDWR));
+	ASSERT(ll_abi >= 0 ? fd == -1 && errno == EACCES : fd >= 0);
+	if (fd >= 0)
+		close(fd);
+	snprintf(procpath, sizeof(procpath), "/proc/self/fd/%d", clone);
+	fd = result("proc_reopen_after_clone", open(procpath, O_RDWR));
+	ASSERT(ll_abi >= 0 ? fd == -1 && errno == EACCES : fd >= 0);
+	if (fd >= 0)
+		close(fd);
+	result("regular_ioctl_managed_clone", ioctl(clone, FIONREAD, &count));
+	ASSERT(!capop(source, F_RESTRICTFD_CAP, 1));
+	ASSERT(!capop(source, F_RESTRICTFD_CAP, 3));
+	ASSERT(capop(alias, F_GETFD_CAP, 0) == 1);
+	clone = result("clone_pre_attenuated_requested_RW", capop(source, F_CLONEFD_CAP, 3));
+	ASSERT(clone >= 0 && capop(clone, F_GETFD_CAP, 0) == 1);
+	ASSERT(!check_read(clone));
+	rc = result("clone_attenuated_pwrite", pwrite(clone, "x", 1, 0));
+	ASSERT(rc == -1 && errno == EBADF);
+	ASSERT(!check_truncate("clone_attenuated_ftruncate", clone, EBADF));
+	rc = result("clone_device", capop(dev, F_CLONEFD_CAP, 3));
+	ASSERT(rc == -1 && errno == EOPNOTSUPP);
+	return 0;
+}
+
+static int post_landlock(void)
+{
+	int fd, clone, alias, fdup, passed, dev, rc;
+	uint64_t ignored;
+	int expected = ll_abi >= 0 ? EACCES : 0;
+
+	close(source);
+	ASSERT(!authority_enter() && !landlock_enter(1));
+	fd = result("fresh_post_RW_no_truncate", openat(afd, "file", O_RDWR));
+	ASSERT(fd >= 0 && !check_read(fd));
+	ASSERT(result("post_pwrite", pwrite(fd, "a", 1, 3)) == 1);
+	ASSERT(!check_truncate("post_ftruncate", fd, expected));
+	alias = result("dup_post", dup(fd));
+	fdup = result("fcntl_dupfd_post", fcntl(fd, F_DUPFD, 20));
+	passed = result("SCM_RIGHTS_post", transfer(fd));
+	ASSERT(alias >= 0 && fdup >= 0 && passed >= 0);
+	ASSERT(!check_truncate("dup_post_ftruncate", alias, expected));
+	ASSERT(!check_truncate("fcntl_dupfd_post_ftruncate", fdup, expected));
+	ASSERT(!check_truncate("SCM_post_ftruncate", passed, expected));
+	ASSERT(!inherited(passed, expected));
+	dev = result("device_open_post", open("/dev/null", O_RDWR));
+	ASSERT(dev >= 0);
+	rc = result("device_ioctl_post", ioctl(dev, BLKGETSIZE64, &ignored));
+	ASSERT(rc == -1 && errno == (ll_abi >= 0 ? EACCES : ENOTTY));
+	if (!has_authority)
+		return 0;
+	clone = result("clone_post_RW", capop(fd, F_CLONEFD_CAP, 3));
+	ASSERT(clone >= 0 && capop(clone, F_GETFD_CAP, 0) == 3);
+	ASSERT(!check_truncate("clone_post_ftruncate", clone, expected));
+	return 0;
+}
+
+static int credentials(void)
+{
+	int fd, clone;
+
+	ASSERT(!authority_enter());
+	ASSERT(!fchmod(source, 0000) && !fchmodat(rootfd, "a", 0000, 0));
+	ASSERT(!landlock_enter(0));
+	ASSERT(setfsuid(65534) == 0 && setfsuid(65534) == 65534);
+	ASSERT(!check_read(source));
+	fd = result("fresh_path_different_fsuid", openat(afd, "file", O_RDONLY));
+	ASSERT(fd == -1 && errno == EACCES);
+	if (!has_authority)
+		return 0;
+	clone = result("clone_saved_opener_fsuid", capop(source, F_CLONEFD_CAP, 1));
+	ASSERT(clone >= 0 && capop(clone, F_GETFD_CAP, 0) == 1);
+	ASSERT(!check_read(clone));
+	return 0;
+}
+
+/* Falsification: no optional file permission may be recovered by pure derivation. */
+static int moved_optional(void)
+{
+	int go[2], ack[2], status, fd, clone, alias;
+	char byte = 0;
+	pid_t helper;
+	struct stat st;
+
+	if (ll_abi < 0)
+		return KSFT_SKIP;
+	close(source);
+	ASSERT(!authority_enter());
+	ASSERT(!pipe(go) && !pipe(ack));
+	helper = fork();
+	ASSERT(helper >= 0);
+	if (!helper) {
+		if (read(go[0], &byte, 1) != 1 || renameat(afd, "file", bfd, "moved") ||
+		    write(ack[1], "x", 1) != 1)
+			_exit(1);
+		_exit(0);
+	}
+	ASSERT(!landlock_enter(1));
+	fd = openat(afd, "file", O_RDWR);
+	ASSERT(fd >= 0 && !check_truncate("optional_source_before_move", fd, EACCES));
+	/* Later layer denies new data opens everywhere and still denies truncation. */
+	ASSERT(!landlock_enter(0));
+	ASSERT(write(go[1], "x", 1) == 1 && read(ack[0], &byte, 1) == 1);
+	ASSERT(waitpid(helper, &status, 0) == helper && WIFEXITED(status) && !WEXITSTATUS(status));
+	alias = dup(fd);
+	ASSERT(alias >= 0);
+	ASSERT(!check_truncate("optional_source_after_move", fd, EACCES));
+	ASSERT(!check_truncate("optional_dup_after_move", alias, EACCES));
+	clone = result("optional_fresh_path_after_move", openat(bfd, "moved", O_RDWR));
+	ASSERT(clone == -1 && errno == EACCES);
+	if (!has_authority)
+		return KSFT_SKIP;
+	clone = result("optional_clone_after_move", capop(fd, F_CLONEFD_CAP, 3));
+	if (clone < 0) {
+		ASSERT(errno == EACCES);
+		ASSERT(!fstat(fd, &st) && st.st_size == 4);
+		ASSERT(capop(fd, F_GETFD_CAP, 0) == 3 && !check_read(fd));
+		ASSERT(!check_truncate("source_after_clone_rejection", fd, EACCES));
+		return 0;
+	}
+	ASSERT(!fstat(clone, &st) && st.st_size == 4);
+	printf("# OBS optional_clone_rights=%d\n", capop(clone, F_GETFD_CAP, 0));
+	status = result("optional_clone_ftruncate_after_move", ftruncate(clone, 0));
+	ASSERT(!fstat(fd, &st));
+	printf("# OBS optional_object_size_after_clone_truncate=%ld\n", (long)st.st_size);
+	ASSERT(status == -1 && errno == EACCES && st.st_size == 4);
+	return 0;
+}
+
+static int samepath_layering(void)
+{
+	int fd, clone;
+
+	if (ll_abi < 0 || !has_authority)
+		return KSFT_SKIP;
+	close(source);
+	ASSERT(!authority_enter() && !landlock_enter(1));
+	fd = openat(afd, "file", O_RDWR);
+	ASSERT(fd >= 0);
+	ASSERT(!landlock_enter(0));
+	ASSERT(!check_truncate("layered_source_truncate", fd, EACCES));
+	clone = result("layered_clone_saved_policy", capop(fd, F_CLONEFD_CAP, 3));
+	ASSERT(clone >= 0 && !check_read(clone));
+	ASSERT(!check_truncate("layered_clone_truncate", clone, EACCES));
+	return 0;
+}
+
+static int delegated_uid(void)
+{
+	int passed, clone, rc;
+
+	ASSERT(!authority_enter() && !landlock_enter(0));
+	passed = transfer(source);
+	ASSERT(passed >= 0);
+	ASSERT(!setgid(65534) && !setuid(65534));
+	ASSERT(!check_read(passed));
+	ASSERT(!check_truncate("delegated_uid_ftruncate", passed, 0));
+	rc = result("delegated_uid_fresh_path", openat(afd, "file", O_RDONLY));
+	ASSERT(rc == -1 && errno == EACCES);
+	if (!has_authority)
+		return 0;
+	clone = result("delegated_uid_clone", capop(passed, F_CLONEFD_CAP, 3));
+	ASSERT(clone >= 0 && capop(clone, F_GETFD_CAP, 0) == 3);
+	ASSERT(!check_read(clone) && !check_truncate("delegated_uid_clone_ftruncate", clone, 0));
+	rc = result("foreign_source_empty_path_link", linkat(passed, "", bfd, "publish", AT_EMPTY_PATH));
+	ASSERT(rc == -1 && errno == ENOENT);
+	rc = result("foreign_clone_empty_path_link", linkat(clone, "", bfd, "publish", AT_EMPTY_PATH));
+	ASSERT(rc == -1 && errno == ENOENT);
+	return 0;
+}
+
+static int authority_boundary(void)
+{
+	char path[128];
+	int fd;
+
+	if (!has_authority || !ENABLE_AUTHORITY)
+		return KSFT_SKIP;
+	ASSERT(!authority_enter());
+	snprintf(path, sizeof(path), "/proc/self/fd/%d", source);
+	fd = result("authority_proc_reopen_authorized", open(path, O_RDWR));
+	ASSERT(fd >= 0);
+	close(fd);
+	fd = result("authority_outside_fresh_open", open(outside_path, O_RDONLY));
+	ASSERT(fd == -1 && errno == EACCES);
+	ASSERT(!check_read(source));
+	return 0;
+}
+
+int main(int argc, char **argv)
+{
+	const struct { const char *name; int (*run)(void); } tests[] = {
+		{ "preexisting aliases clone attenuation fresh paths", preexisting },
+		{ "post-Landlock optional truncate ioctl state", post_landlock },
+		{ "changed FSUID and denied DAC traversal", credentials },
+		{ "same-path nested Landlock and saved credentials", samepath_layering },
+		{ "moved object must not recover stored optional permissions", moved_optional },
+		{ "Authority fresh-path versus established FD boundary", authority_boundary },
+		{ "different UID preserves delegated FD and saved-credential link guard", delegated_uid },
+	};
+	char directory[] = "/tmp/landlock-fd-XXXXXX";
+	int status, fd;
+	unsigned int i;
+	pid_t pid;
+
+	setvbuf(stdout, NULL, _IONBF, 0);
+	self = realpath(argv[0], NULL);
+	ASSERT(self);
+	if (argc == 4 && !strcmp(argv[1], "--probe")) {
+		fd = atoi(argv[2]);
+		ASSERT(!check_read(fd));
+		ASSERT(!check_truncate("fork_exec_ftruncate", fd, atoi(argv[3])));
+		return 0;
+	}
+	has_authority = prctl(PR_CAPAUTH, PR_CAPAUTH_GET_CONFINED, 0, 0, 0) == 0;
+	ll_abi = syscall(SYS_landlock_create_ruleset, NULL, 0, LANDLOCK_CREATE_RULESET_VERSION);
+	printf("# PLATFORM authority_api=%d authority_domain_requested=%d landlock_abi=%d errno=%d\n",
+	       has_authority, ENABLE_AUTHORITY, ll_abi, ll_abi < 0 ? errno : 0);
+	ksft_print_header();
+	if (geteuid())
+		ksft_exit_skip("requires root in a disposable guest\n");
+	ksft_set_plan(ARRAY_SIZE(tests));
+	fd = mkstemp(outside_path);
+	ASSERT(fd >= 0);
+	close(fd);
+	for (i = 0; i < ARRAY_SIZE(tests); i++) {
+		strcpy(directory, "/tmp/landlock-fd-XXXXXX");
+		ASSERT(mkdtemp(directory));
+		rootfd = open(directory, O_PATH | O_DIRECTORY);
+		ASSERT(rootfd >= 0);
+		ASSERT(!mkdirat(rootfd, "a", 0700) && !mkdirat(rootfd, "b", 0700));
+		afd = openat(rootfd, "a", O_PATH | O_DIRECTORY);
+		bfd = openat(rootfd, "b", O_PATH | O_DIRECTORY);
+		ASSERT(afd >= 0 && bfd >= 0);
+		source = openat(afd, "file", O_CREAT | O_RDWR, 0600);
+		ASSERT(source >= 0 && write(source, "data", 4) == 4);
+		pid = fork();
+		ASSERT(pid >= 0);
+		if (!pid) {
+			printf("# CASE pid=%ld name=%s\n", (long)getpid(), tests[i].name);
+			_exit(tests[i].run());
+		}
+		ASSERT(waitpid(pid, &status, 0) == pid);
+		if (WIFEXITED(status) && WEXITSTATUS(status) == KSFT_SKIP)
+			ksft_test_result_skip("%s\n", tests[i].name);
+		else
+			ksft_test_result(WIFEXITED(status) && !WEXITSTATUS(status), "%s\n", tests[i].name);
+		close(source);
+		fchmodat(rootfd, "a", 0700, 0);
+		unlinkat(afd, "file", 0);
+		unlinkat(bfd, "moved", 0);
+		close(afd);
+		close(bfd);
+		unlinkat(rootfd, "a", AT_REMOVEDIR);
+		unlinkat(rootfd, "b", AT_REMOVEDIR);
+		close(rootfd);
+		rmdir(directory);
+	}
+	unlink(outside_path);
+	free(self);
+	ksft_finished();
+}
