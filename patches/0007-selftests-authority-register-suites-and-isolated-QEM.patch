diff --git a/tools/testing/selftests/authority/run-qemu.sh b/tools/testing/selftests/authority/run-qemu.sh
new file mode 100755
index 0000000000000000000000000000000000000000..062b58485aed5aaf60208badefea76a48a6609ac
--- /dev/null
+++ b/tools/testing/selftests/authority/run-qemu.sh
@@ -0,0 +1,67 @@
+#!/bin/bash
+# SPDX-License-Identifier: GPL-2.0
+# Only boots an isolated guest. Requires statically linked test executables.
+set -euo pipefail
+if [ "$#" -lt 4 ]; then
+	echo "usage: $0 bzImage busybox-static NEW-EVIDENCE-DIRECTORY test-executable..." >&2
+	exit 2
+fi
+kernel=$(realpath "$1")
+busybox=$(realpath "$2")
+out=$(realpath -m "$3")
+shift 3
+# Never overwrite evidence or use the host filesystem as a guest disk.
+mkdir "$out"
+mkdir -p "$out/root"/{bin,dev,proc,sys,tmp,tests}
+cp "$busybox" "$out/root/bin/busybox"
+ln -s busybox "$out/root/bin/sh"
+cp "$kernel" "$out/bzImage"
+if [ -n "${QEMU_ASSETS:-}" ]; then
+	cp -a "$QEMU_ASSETS/." "$out/root/tests/"
+fi
+cat > "$out/root/init" <<'INIT'
+#!/bin/sh
+set -eu
+/bin/busybox mount -t devtmpfs devtmpfs /dev
+/bin/busybox mount -t proc proc /proc
+/bin/busybox mount -t sysfs sysfs /sys
+/bin/busybox mount -t tmpfs tmpfs /tmp
+INIT
+for test in "$@"; do
+	name=$(basename "$test")
+	[[ "$name" =~ ^[a-zA-Z0-9_-]+$ ]] || exit 2
+	test ! -e "$out/root/tests/$name"
+	cp "$test" "$out/root/tests/$name"
+	cat >> "$out/root/init" <<INIT
+/bin/busybox mkdir /tmp/run-$name
+cd /tmp/run-$name
+/bin/busybox cp -a /tests/. .
+/bin/busybox chown 0:0 .
+rc=0
+./$name || rc=\$?
+echo "SUITE $name EXIT=\$rc"
+cd /
+INIT
+done
+printf 'echo KERNEL_LOG_BEGIN\n/bin/busybox dmesg\necho KERNEL_LOG_END\n' >> "$out/root/init"
+printf 'echo AUTHORITY_GUEST_DONE\n/bin/busybox poweroff -f\n' >> "$out/root/init"
+chmod +x "$out/root/init"
+find "$out/root" -exec touch -h -d "@${SOURCE_DATE_EPOCH:-0}" {} +
+(cd "$out/root"; find . -print0 | LC_ALL=C sort -z |
+	cpio --null -o -H newc --reproducible --owner=0:0) \
+	2> "$out/cpio.log" | gzip -n > "$out/initramfs.gz"
+command=(qemu-system-x86_64 -machine q35,accel=kvm -cpu host -m 4096 -smp 4
+	-kernel "$out/bzImage" -initrd "$out/initramfs.gz"
+	-append 'console=ttyS0 rdinit=/init panic=-1 loglevel=4' -nic none -display none
+	-serial "file:$out/serial.log" -monitor none -no-reboot)
+printf '%q ' "${command[@]}" > "$out/command.txt"
+printf '\n' >> "$out/command.txt"
+timeout "${QEMU_TIMEOUT:-600}" "${command[@]}"
+(cd "$out"; sha256sum bzImage initramfs.gz root/tests/* > SHA256SUMS)
+grep -q AUTHORITY_GUEST_DONE "$out/serial.log"
+# A missing/interleaved exit marker is an evidence failure, never a pass.
+[ "$(tr -d '\r' < "$out/serial.log" | grep -Ec '^SUITE .* EXIT=[04]$')" -eq "$#" ]
+# A powered-off QEMU is not evidence that its tests passed.
+errors='SUITE .* EXIT=([^04]|[04][0-9])|BUG:|WARNING:|KASAN:|KCSAN:'
+errors+='|possible circular locking|not ok'
+! grep -Eq "$errors" "$out/serial.log"
