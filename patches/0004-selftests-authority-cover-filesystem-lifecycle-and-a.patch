+static int reuse_slot;
+static void *close_worker(void *arg)
+{
+	int i;
+
+	(void)arg;
+	while (!atomic_load(&start))
+		sched_yield();
+	for (i = 0; i < 4000; i++) {
+		if (dup2(datafd, reuse_slot) != reuse_slot)
+			return (void *)1;
+		close(reuse_slot);
+	}
+	return NULL;
+}
+
+static int close_race(void)
+{
+	pthread_t thread;
+	void *result;
+	int i, fd;
+
+	CHECK(!capop(datafd, F_RESTRICTFD_CAP, 0));
+	/* Keep clone outputs away from the deliberately recycled slot. */
+	reuse_slot = 200;
+	CHECK(dup2(datafd, reuse_slot) == reuse_slot);
+	CHECK(!pthread_create(&thread, NULL, close_worker, NULL));
+	atomic_store(&start, 1);
+	for (i = 0; i < 4000; i++) {
+		fd = capop(reuse_slot, F_CLONEFD_CAP, 3);
+		if (fd < 0) {
+			CHECK(errno == EBADF);
+			continue;
+		}
+		CHECK(capop(fd, F_GETFD_CAP, 0) == 0);
+		close(fd);
+	}
+	CHECK(!pthread_join(thread, &result) && !result);
+	return 0;
+}
