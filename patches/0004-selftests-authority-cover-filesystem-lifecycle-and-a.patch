+ if(variant&2)CHECK(pwrite(fd,"d",1,0)==1);else{errno=0;CHECK(pwrite(fd,"x",1,0)==-1&&errno==EBADF);}
+ char proc[120];snprintf(proc,sizeof(proc),"/proc/%d/fd/%d",child,remote);
