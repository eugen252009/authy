+static int dac_grant(void)
+{
+	int fd;
+	char c;
+
+	CHECK(!fchmod(datafd, 0000));
+	CHECK(!fchmodat(rootfd, "in", 0711, 0));
+	CHECK(!scope(inside, READ_SCOPE));
+	CHECK(!confine(1U << READ_SCOPE));
+	CHECK(setfsuid(65534) == 0);
+	CHECK(setfsuid(65534) == 65534);
+	fd = openat(inside, "file", O_RDONLY);
+	CHECK(fd >= 0 && read(fd, &c, 1) == 1 && c == 'd');
+	close(fd);
+	DENIED(openat(inside, "file", O_WRONLY), EACCES);
+	return 0;
+}
