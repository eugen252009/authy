+#define CHECK(c) do {if(!(c)){dprintf(2,"# %s:%d %s errno=%d\n",__func__,__LINE__,#c,errno);return 1;}} while(0)
+static int api,variant;static char dir[100],path[150];static int rootfd;
+static int capop(int fd,int op,int bits)
+{
+ union{uint64_t align;unsigned char b[sizeof(struct fd_cap_request)+1];}s={};
+ struct fd_cap_request*r=(void*)s.b;r->size=sizeof(s.b);r->version=FD_CAP_VERSION_1;r->rights[0]=bits;
+ int rc=fcntl(fd,op,r);return !rc&&op==F_GETFD_CAP?r->rights[0]:rc;
