+static int object_binding(void)
+{
+	int replacement, fd;
+
+	CHECK(!scope(inside, READ_SCOPE));
+	CHECK(!renameat(rootfd, "in", rootfd, "moved"));
+	CHECK(!mkdirat(rootfd, "in", 0700));
+	replacement = openat(rootfd, "in", O_DIRECTORY);
+	CHECK(replacement >= 0);
+	fd = openat(replacement, "file", O_CREAT | O_RDWR, 0600);
+	CHECK(fd >= 0);
+	close(fd);
+	/* Reuse the old scope handle number for a different object. */
+	CHECK(dup2(replacement, inside) == inside);
+	CHECK(!confine(1U << READ_SCOPE));
+	DENIED(openat(inside, "file", O_RDONLY), EACCES);
+	fd = openat(rootfd, "moved/file", O_RDONLY);
+	CHECK(fd >= 0);
+	close(fd);
+	return 0;
+}
