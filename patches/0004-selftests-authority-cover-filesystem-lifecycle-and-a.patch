+static int private_mountns(char *path, size_t size)
+{
+	char procpath[80];
+	ssize_t len;
+
+	snprintf(procpath, sizeof(procpath), "/proc/self/fd/%d", rootfd);
+	len = readlink(procpath, path, size - 1);
+	CHECK(len > 0 && (size_t)len < size - 1);
+	path[len] = 0;
+	CHECK(!unshare(CLONE_NEWNS));
+	CHECK(!mount(NULL, "/", NULL, MS_REC | MS_PRIVATE, NULL));
+	/* Inherited FDs pin the OLD namespace's mounts, not their new clones. */
+	close(rootfd);
+	close(inside);
+	rootfd = open(path, O_PATH | O_DIRECTORY);
+	CHECK(rootfd >= 0);
+	inside = openat(rootfd, "in", O_PATH | O_DIRECTORY);
+	CHECK(inside >= 0);
+	return 0;
+}
+
+static int mount_binding(void)
+{
+	char path[256], src[300], dst[300];
+	int alias;
+
+	CHECK(!private_mountns(path, sizeof(path)));
+	snprintf(src, sizeof(src), "%s/in", path);
+	snprintf(dst, sizeof(dst), "%s/out", path);
+	CHECK(!mount(src, dst, NULL, MS_BIND, NULL));
+	alias = openat(rootfd, "out", O_PATH | O_DIRECTORY);
+	CHECK(alias >= 0);
+	CHECK(!scope(inside, READ_SCOPE));
+	CHECK(!confine(1U << READ_SCOPE));
+	DENIED(openat(alias, "file", O_RDONLY), EACCES);
+	return 0;
+}
+
+static int attenuation(void)
+{
+	char c;
+	int alias, clone, zero, replacement;
+
+	CHECK(!capop(datafd, F_RESTRICTFD_CAP, 1));
+	alias = dup(datafd);
+	CHECK(alias >= 0 && capop(alias, F_GETFD_CAP, 0) == 1);
+	DENIED(write(alias, "!", 1), EBADF);
+	DENIED(pwrite(alias, "!", 1, 0), EBADF);
+	DENIED(ftruncate(alias, 0), EBADF);
+	CHECK(!capop(alias, F_RESTRICTFD_CAP, 3));
+	CHECK(capop(alias, F_GETFD_CAP, 0) == 1);
+	clone = capop(alias, F_CLONEFD_CAP, 3);
+	CHECK(clone >= 0 && capop(clone, F_GETFD_CAP, 0) == 1);
+	DENIED(pwrite(clone, "!", 1, 0), EBADF);
+	CHECK(pread(clone, &c, 1, 0) == 1 && c == 'd');
+	CHECK(!capop(alias, F_RESTRICTFD_CAP, 0));
+	CHECK(capop(datafd, F_GETFD_CAP, 0) == 0);
+	CHECK(capop(clone, F_GETFD_CAP, 0) == 1);
+	zero = capop(datafd, F_CLONEFD_CAP, 3);
+	CHECK(zero >= 0 && capop(zero, F_GETFD_CAP, 0) == 0);
+	DENIED(read(zero, &c, 1), EBADF);
+	close(datafd);
+	replacement = openat(inside, "file", O_RDWR);
+	CHECK(replacement == datafd);
+	CHECK(capop(replacement, F_GETFD_CAP, 0) == 3);
+	CHECK(capop(alias, F_GETFD_CAP, 0) == 0);
+	return 0;
+}
