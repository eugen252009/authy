+static int landlock_denial(void)
+{
+	struct landlock_ruleset_attr attr = { .handled_access_fs = LANDLOCK_ACCESS_FS_READ_FILE };
+	int ruleset, clone;
+	char c;
+
+	ruleset = syscall(SYS_landlock_create_ruleset, &attr, sizeof(attr), 0);
+	if (ruleset < 0 && (errno == ENOSYS || errno == EOPNOTSUPP))
+		return KSFT_SKIP;
+	CHECK(ruleset >= 0);
+	CHECK(!scope(inside, READ_SCOPE));
+	CHECK(!confine(1U << READ_SCOPE));
+	CHECK(!syscall(SYS_landlock_restrict_self, ruleset, 0));
+	DENIED(openat(inside, "file", O_RDONLY), EACCES);
+	/* This is derivation from an existing bearer FD, not a pathname open. */
+	clone = capop(datafd, F_CLONEFD_CAP, 1);
+	CHECK(clone >= 0 && capop(clone, F_GETFD_CAP, 0) == 1);
+	CHECK(pread(clone, &c, 1, 0) == 1 && c == 'd');
+	DENIED(pwrite(clone, "x", 1, 0), EBADF);
+	close(clone);
+	close(ruleset);
+	return 0;
+}
