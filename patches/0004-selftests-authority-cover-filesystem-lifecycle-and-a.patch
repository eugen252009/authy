+#include <sys/xattr.h>
+#include <sys/syscall.h>
+#include <sys/wait.h>
+#include <unistd.h>
+#include "../kselftest.h"
+
+#define READ_SCOPE PR_CAPAUTH_FS_READ_FILE
+#define WRITE_SCOPE PR_CAPAUTH_FS_WRITE_FILE
+#define ALL_OPS 0xfa
+#ifndef TEST_FS
+#define TEST_FS "tmpfs"
+#endif
+#define CHECK(x) do { if (!(x)) { \
+	dprintf(2, "# %s:%d: %s errno=%d\n", __func__, __LINE__, #x, errno); \
+	return 1; } } while (0)
+#define DENIED(x, e) do { errno = 0; CHECK((x) == -1 && errno == (e)); } while (0)
+
+static int rootfd, inside, outside, datafd;
+static const char *self;
+
+static int confine(unsigned char bits)
+{
+	union {
+		uint64_t align;
+		unsigned char bytes[sizeof(struct pr_capauth_confine) + 1];
+	} storage = {};
+	struct pr_capauth_confine *r = (void *)storage.bytes;
+
+	r->size = sizeof(storage.bytes);
+	r->version = PR_CAPAUTH_CONFINE_VERSION_1;
+	r->handled[0] = bits;
+	return prctl(PR_CAPAUTH, PR_CAPAUTH_CONFINE, (unsigned long)r, 0, 0);
+}
+
+static int scope(int fd, int right)
+{
+	return prctl(PR_CAPAUTH, PR_CAPAUTH_ADD_FS_SCOPE,
+		     (unsigned long)fd, (unsigned long)right, 0);
+}
+
+static int capop(int fd, int cmd, unsigned char mask)
+{
+	union {
+		uint64_t align;
+		unsigned char bytes[sizeof(struct fd_cap_request) + 1];
+	} storage = {};
+	struct fd_cap_request *r = (void *)storage.bytes;
+	int ret;
+
+	r->size = sizeof(storage.bytes);
+	r->version = FD_CAP_VERSION_1;
+	r->rights[0] = mask;
+	ret = fcntl(fd, cmd, r);
+	return cmd == F_GETFD_CAP && !ret ? r->rights[0] : ret;
+}
+
+static int open2(int dir, const char *name, uint64_t flags, uint64_t resolve)
+{
+	struct open_how how = { .flags = flags, .resolve = resolve };
+
+	return syscall(SYS_openat2, dir, name, &how, sizeof(how));
+}
+
+/* mode 0: ordinary Linux, 1: empty selective domain, 2: denied, 3: grant. */
+static int path_matrix(int mode)
+{
+	int fd, ret, r;
+	char absolute[256];
+	struct stat st;
+	struct statx sx;
+
+	if (mode == 3)
+		for (r = 1; r <= 7; r++)
+			if (r != PR_CAPAUTH_FS_TRAVERSE)
+				CHECK(!scope(inside, r));
+	if (mode)
+		CHECK(!confine(mode == 1 ? 0 : ALL_OPS));
+	CHECK(!fchdir(rootfd));
+	CHECK(getcwd(absolute, sizeof(absolute)));
+	CHECK(strlen(absolute) + 10 < sizeof(absolute));
+	strcat(absolute, "/in/file");
+	for (r = 0; r < 3; r++) {
+		fd = r == 0 ? open(absolute, O_RDWR) : r == 1 ?
+			openat(inside, "file", O_RDWR) : open2(inside, "file", O_RDWR, 0);
+		if (mode == 2) {
+			CHECK(fd == -1 && errno == EACCES);
+		} else {
+			CHECK(fd >= 0);
+			CHECK(pwrite(fd, "A", 1, 0) == 1);
+			CHECK(!ftruncate(fd, 3));
+			CHECK(!fstat(fd, &st) && st.st_size == 3);
+			close(fd);
+		}
+	}
+	/* Metadata, mkdir/rmdir and symlink are deliberately not handled rights. */
+	CHECK(!stat(absolute, &st));
+	CHECK(!statx(inside, "file", 0, STATX_SIZE, &sx));
+	CHECK(!mkdirat(inside, "directory", 0700));
+	CHECK(!unlinkat(inside, "directory", AT_REMOVEDIR));
+	CHECK(!mkdir("in/directory", 0700));
+	CHECK(!rmdir("in/directory"));
+	CHECK(!symlinkat("file", inside, "sym"));
+	CHECK(!symlink("file", "in/sym2"));
+	ret = truncate(absolute, 2);
+	if (mode == 2)
+		CHECK(ret == -1 && errno == EACCES && st.st_size == 4);
+	else
+		CHECK(!ret);
+	fd = openat(inside, "created", O_CREAT | O_EXCL | O_WRONLY, 0600);
+	if (mode == 2) {
+		CHECK(fd == -1 && errno == EACCES);
+		DENIED(fstatat(inside, "created", &st, 0), ENOENT);
+	} else {
+		CHECK(fd >= 0);
+		close(fd);
+	}
+	ret = link("in/file", "in/hard");
+	if (mode == 2) {
+		CHECK(ret == -1 && errno == EACCES);
+		DENIED(fstatat(inside, "hard", &st, 0), ENOENT);
+	} else {
+		CHECK(!ret);
+		CHECK(!linkat(inside, "file", inside, "hard2", 0));
+	}
+	ret = rename("in/victim", "in/renamed");
+	if (mode == 2) {
+		CHECK(ret == -1 && errno == EACCES);
+		CHECK(!fstatat(inside, "victim", &st, 0));
+		DENIED(fstatat(inside, "renamed", &st, 0), ENOENT);
+	} else {
+		CHECK(!ret);
+		CHECK(!syscall(SYS_renameat2, inside, "renamed", inside, "victim", 0));
+	}
+	ret = unlink("in/victim");
+	if (mode == 2) {
+		CHECK(ret == -1 && errno == EACCES);
+		DENIED(unlinkat(inside, "victim", 0), EACCES);
+		CHECK(!fstatat(inside, "victim", &st, 0));
+	} else {
+		CHECK(!ret);
+		CHECK(!unlinkat(inside, "sym", 0));
+	}
+	/* An allowed directory never confers fresh data/creation rights outside it. */
+	if (mode >= 2) {
+		DENIED(openat(outside, "file", O_WRONLY), EACCES);
+		DENIED(openat(outside, "new", O_CREAT | O_WRONLY, 0600), EACCES);
+		DENIED(fstatat(outside, "new", &st, 0), ENOENT);
+		DENIED(linkat(inside, "file", outside, "newlink", 0), EACCES);
+		DENIED(fstatat(outside, "newlink", &st, 0), ENOENT);
+	}
+	return 0;
+}
+
+static int legacy(void) { return path_matrix(0); }
+static int unhandled(void) { return path_matrix(1); }
+static int denied(void) { return path_matrix(2); }
+static int allowed(void) { return path_matrix(3); }
+
+static int resolution(void)
+{
+	int fd;
+
+	CHECK(!symlinkat("../out/file", inside, "escape"));
+	CHECK(!scope(inside, READ_SCOPE));
+	CHECK(!confine(1U << READ_SCOPE));
+	DENIED(openat(inside, "escape", O_RDONLY), EACCES);
+	DENIED(openat(inside, "../out/file", O_RDONLY), EACCES);
+	DENIED(open2(inside, "escape", O_RDONLY, RESOLVE_BENEATH), EXDEV);
+	DENIED(open2(inside, "../out/file", O_RDONLY, RESOLVE_BENEATH), EXDEV);
+	DENIED(open2(inside, "/file", O_RDONLY, RESOLVE_BENEATH), EXDEV);
+	fd = open2(inside, "/file", O_RDONLY, RESOLVE_IN_ROOT);
+	CHECK(fd >= 0);
+	close(fd);
+	fd = open2(inside, "../file", O_RDONLY, RESOLVE_IN_ROOT);
+	CHECK(fd >= 0);
+	close(fd);
+	DENIED(open2(inside, "escape", O_RDONLY, RESOLVE_IN_ROOT), ENOENT);
+	/* Traversal and metadata visibility outside scopes are NOT confinement. */
+	CHECK(!fchdir(outside));
+	return 0;
+}
