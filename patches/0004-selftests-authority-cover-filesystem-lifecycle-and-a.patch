+ r->sqes=mmap(0,r->p.sq_entries*sizeof(*r->sqes),PROT_READ|PROT_WRITE,MAP_SHARED,r->fd,IORING_OFF_SQES);CHECK(r->sqes!=MAP_FAILED);return 0;
+}
+static int issue(struct ring*r,int opcode,int fd,void*data,int len,int fixed)
+{
+ unsigned *tail=r->sq+r->p.sq_off.tail,*mask=r->sq+r->p.sq_off.ring_mask,*array=r->sq+r->p.sq_off.array;
+ unsigned t=*tail,idx=t&*mask;struct io_uring_sqe*s=&r->sqes[idx];memset(s,0,sizeof(*s));
+ s->opcode=opcode;s->fd=fd;s->addr=(uintptr_t)data;s->len=len;if(fixed)s->flags=IOSQE_FIXED_FILE;
+ array[idx]=idx;__atomic_store_n(tail,t+1,__ATOMIC_RELEASE);
+ int rc=syscall(SYS_io_uring_enter,r->fd,1,1,IORING_ENTER_GETEVENTS,0,0);if(rc<0)return -10000-errno;
+ unsigned *head=r->cq+r->p.cq_off.head,*ct=r->cq+r->p.cq_off.tail,*cm=r->cq+r->p.cq_off.ring_mask;
+ if(*head==__atomic_load_n(ct,__ATOMIC_ACQUIRE))return -20000;
+ struct io_uring_cqe*c=r->cq+r->p.cq_off.cqes;int result=c[*head&*cm].res;__atomic_store_n(head,*head+1,__ATOMIC_RELEASE);return result;
+}
+static int uring(void)
+{
+ struct ring r;int fd,result;char c=0;CHECK(!setup()&&!ring_setup(&r));
+ fd=open(path,O_RDWR);CHECK(fd>=0);
+ if(variant){CHECK(!syscall(SYS_io_uring_register,r.fd,IORING_REGISTER_FILES,&fd,1));}
+ CHECK(!confine());
+ if(!variant){result=issue(&r,IORING_OP_OPENAT,AT_FDCWD,path,0,0);printf("# ring created before confinement OPENAT result=%d\n",result);CHECK(result==-EACCES);return 0;}
+ CHECK(!capop(fd,F_RESTRICTFD_CAP,1));
+ if(variant==2){int alias=dup(fd);struct io_uring_files_update u={.offset=0,.fds=(uintptr_t)&alias};CHECK(syscall(SYS_io_uring_register,r.fd,IORING_REGISTER_FILES_UPDATE,&u,1)==1);}
+ CHECK(issue(&r,IORING_OP_READ,0,&c,1,1)==1&&c=='d');
+ result=issue(&r,IORING_OP_WRITE,0,"x",1,1);CHECK(result==-EBADF||result==-EACCES);
+ CHECK(!capop(fd,F_RESTRICTFD_CAP,0));result=issue(&r,IORING_OP_READ,0,&c,1,1);CHECK(result==-EBADF||result==-EACCES);return 0;
+}
+static int anonymous(void)
+{
+ int fd;void *p;CHECK(!confine());fd=memfd_create("out-of-path-scope",MFD_CLOEXEC);CHECK(fd>=0&&!ftruncate(fd,4096)&&write(fd,"data",4)==4);
+ p=mmap(0,4096,PROT_READ|PROT_WRITE,MAP_SHARED,fd,0);CHECK(p!=MAP_FAILED);memcpy(p,"data",4);
+ CHECK(capop(fd,F_GETFD_CAP,0)==3);
+ int id=shmget(IPC_PRIVATE,4096,IPC_CREAT|0600);CHECK(id>=0);
+ void *shared=shmat(id,NULL,0);CHECK(shared!=(void*)-1);memcpy(shared,"data",4);
+ CHECK(!shmctl(id,IPC_RMID,NULL)&&!shmdt(shared));return 0;
+}
+int main(void)
+{
+ const struct{const char*name;int(*run)(void);int v,need;}cases[]={
+ {"pidfd imports full bearer; procfs reacquisition denies",pidfd_import,3,1},
+ {"pidfd imports READ-only shared attenuation",pidfd_import,1,1},{"pidfd imports zero-right shared attenuation",pidfd_import,0,1},
+ {"O_PATH is not data acquisition; procfs repeats acquisition",opath,0,1},
+ {"native fanotify readable description",notification,-1,0},{"fanotify denied fresh event descriptor",notification,0,1},
+ {"fanotify scoped fresh event descriptor attenuates",notification,1,1},
+ {"preexisting ordinary io_uring still checks fresh OPENAT",uring,0,1},
+ {"fixed io_uring registration shares later attenuation",uring,1,1},{"fixed io_uring update shares later attenuation",uring,2,1},
+ {"memfd is anonymous storage outside pathname scope",anonymous,0,1}};
+ int rc,status;pid_t pid;setvbuf(stdout,NULL,_IONBF,0);ksft_print_header();if(geteuid())ksft_exit_skip("requires isolated root guest\n");
+ errno=0;rc=prctl(PR_CAPAUTH,PR_CAPAUTH_GET_CONFINED,0UL,0UL,0UL);if(rc==-1&&errno!=EINVAL)ksft_exit_fail_msg("query error\n");if(rc>0)ksft_exit_fail_msg("already confined\n");api=rc==0;
+ ksft_set_plan(ARRAY_SIZE(cases));for(unsigned i=0;i<ARRAY_SIZE(cases);i++){
+  if(cases[i].need&&!api){ksft_test_result_skip("%s (API unavailable)\n",cases[i].name);continue;}
+  variant=cases[i].v;pid=fork();CHECK(pid>=0);if(!pid)_exit(cases[i].run());CHECK(waitpid(pid,&status,0)==pid);
+  ksft_test_result(WIFEXITED(status)&&!WEXITSTATUS(status),"%s\n",cases[i].name);
+ }ksft_finished();
+}
diff --git a/tools/testing/selftests/authority/handle_test.c b/tools/testing/selftests/authority/handle_test.c
