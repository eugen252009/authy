+static int confine(void)
+{
+ union{uint64_t align;unsigned char b[sizeof(struct pr_capauth_confine)+1];}s={};
+ struct pr_capauth_confine*r=(void*)s.b;r->size=sizeof(s.b);r->version=PR_CAPAUTH_CONFINE_VERSION_1;r->handled[0]=0x18;
+ return prctl(PR_CAPAUTH,PR_CAPAUTH_CONFINE,(unsigned long)r,0UL,0UL);
+}
+static int setup(void)
+{
+ int fd;strcpy(dir,"/tmp/authority-est.XXXXXX");CHECK(mkdtemp(dir));rootfd=open(dir,O_PATH|O_DIRECTORY);CHECK(rootfd>=0);
+ snprintf(path,sizeof(path),"%s/file",dir);fd=open(path,O_CREAT|O_RDWR,0600);CHECK(fd>=0&&write(fd,"data",4)==4);close(fd);return 0;
+}
+static int pidfd_import(void)
+{
+ int ready[2],hold[2],remote,fd,pidfd,status;pid_t child;char c;
+ CHECK(!setup()&&!pipe(ready)&&!pipe(hold));child=fork();CHECK(child>=0);
+ if(!child){close(ready[0]);close(hold[1]);remote=open(path,O_RDWR);if(remote<0)_exit(1);
+  if(variant!=3&&capop(remote,F_RESTRICTFD_CAP,variant))_exit(1);
