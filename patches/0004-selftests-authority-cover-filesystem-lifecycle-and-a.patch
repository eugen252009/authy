+static atomic_int start;
+static void *restrict_worker(void *arg)
+{
+	unsigned long mask = (uintptr_t)arg;
+	int i;
+
+	while (!atomic_load(&start))
+		sched_yield();
+	for (i = 0; i < 2000; i++)
+		if (capop(datafd, F_RESTRICTFD_CAP, mask))
+			return (void *)1;
+	return NULL;
+}
+
+static void *clone_worker(void *arg)
+{
+	int i, fd;
+
+	(void)arg;
+	while (!atomic_load(&start))
+		sched_yield();
+	for (i = 0; i < 2000; i++) {
+		fd = capop(datafd, F_CLONEFD_CAP, 3);
+		if (fd < 0)
+			return (void *)1;
+		close(fd);
+	}
+	return NULL;
+}
+
+static int concurrency(void)
+{
+	pthread_t threads[4];
+	void *result;
+	int i, fd;
+	char c;
+
+	CHECK(!pthread_create(&threads[0], NULL, restrict_worker, (void *)1));
+	CHECK(!pthread_create(&threads[1], NULL, restrict_worker, (void *)2));
+	CHECK(!pthread_create(&threads[2], NULL, clone_worker, NULL));
+	CHECK(!pthread_create(&threads[3], NULL, clone_worker, NULL));
+	atomic_store(&start, 1);
+	for (i = 0; i < 4; i++) {
+		CHECK(!pthread_join(threads[i], &result));
+		CHECK(!result);
+	}
+	CHECK(capop(datafd, F_GETFD_CAP, 0) == 0);
+	for (i = 0; i < 2000; i++) {
+		fd = capop(datafd, F_CLONEFD_CAP, 3);
+		CHECK(fd >= 0 && capop(fd, F_GETFD_CAP, 0) == 0);
+		DENIED(pwrite(fd, "!", 1, 0), EBADF);
+		DENIED(pread(fd, &c, 1, 0), EBADF);
+		close(fd);
+	}
+	return 0;
+}
