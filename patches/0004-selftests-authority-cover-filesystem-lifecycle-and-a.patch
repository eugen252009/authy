+static int symlink_race(void)
+{
+	int outside_data, fd, i, status;
+	char contents[4];
+	pid_t pid;
+
+	outside_data = openat(outside, "file", O_RDONLY);
+	CHECK(outside_data >= 0);
+	CHECK(!symlinkat("file", inside, "race"));
+	CHECK(!symlinkat("../out/file", inside, "gate"));
+	pid = fork();
+	CHECK(pid >= 0);
+	if (!pid) {
+		for (i = 0; i < 5000; i++)
+			if (syscall(SYS_renameat2, inside, "race", inside, "gate", RENAME_EXCHANGE))
+				_exit(1);
+		_exit(0);
+	}
+	CHECK(!scope(inside, WRITE_SCOPE));
+	CHECK(!confine(1U << WRITE_SCOPE));
+	for (i = 0; i < 5000; i++) {
+		fd = openat(inside, "race", O_WRONLY);
+		if (fd < 0) {
+			CHECK(errno == EACCES);
+			continue;
+		}
+		CHECK(pwrite(fd, "!", 1, 0) == 1);
+		close(fd);
+	}
+	CHECK(waitpid(pid, &status, 0) == pid && WIFEXITED(status) && !WEXITSTATUS(status));
+	CHECK(pread(outside_data, contents, sizeof(contents), 0) == sizeof(contents));
+	CHECK(!memcmp(contents, "data", sizeof(contents)));
+	close(outside_data);
+	return 0;
+}
+
+static void *transition_worker(void *arg)
+{
+	int fd;
+
+	if (!arg) {
+		while (!atomic_load(&start))
+			sched_yield();
+		return NULL;
+	}
+	if (prctl(PR_CAPAUTH, PR_CAPAUTH_DROP_FS_SCOPE_RIGHT,
+		  (unsigned long)inside, (unsigned long)READ_SCOPE, 0))
+		return (void *)1;
+	fd = openat(inside, "file", O_RDONLY);
+	if (fd != -1 || errno != EACCES) {
+		if (fd >= 0)
+			close(fd);
+		return (void *)1;
+	}
+	return NULL;
+}
+
+static int transitions(void)
+{
+	pthread_t thread;
+	void *result;
+	int fd, ret, attempts;
+
+	CHECK(!scope(inside, READ_SCOPE));
+	CHECK(!pthread_create(&thread, NULL, transition_worker, NULL));
+	DENIED(confine(1U << READ_SCOPE), EBUSY);
+	CHECK(!prctl(PR_CAPAUTH, PR_CAPAUTH_GET_CONFINED, 0, 0, 0));
+	atomic_store(&start, 1);
+	CHECK(!pthread_join(thread, &result) && !result);
+	/* clear_child_tid/join can precede removal from the kernel thread group. */
+	for (attempts = 0; attempts < 10000; attempts++) {
+		ret = confine(1U << READ_SCOPE);
+		if (!ret || errno != EBUSY)
+			break;
+		usleep(1000);
+	}
+	CHECK(!ret);
+	CHECK(!pthread_create(&thread, NULL, transition_worker, (void *)1));
+	CHECK(!pthread_join(thread, &result) && !result);
+	/* Reduction replaces the calling task's immutable credential authority. */
+	fd = openat(inside, "file", O_RDONLY);
+	CHECK(fd >= 0);
+	close(fd);
+	CHECK(!prctl(PR_CAPAUTH, PR_CAPAUTH_DROP_FS_SCOPE_RIGHT,
+		     (unsigned long)inside, (unsigned long)READ_SCOPE, 0));
+	DENIED(openat(inside, "file", O_RDONLY), EACCES);
+	return 0;
+}
+
+static int credential_lifetime(void)
+{
+	int i, status;
+	pid_t pid;
+
+	for (i = 0; i < 128; i++) {
+		pid = fork();
+		CHECK(pid >= 0);
+		if (!pid) {
+			if (scope(inside, READ_SCOPE) || confine(1U << READ_SCOPE) ||
+			    prctl(PR_CAPAUTH, PR_CAPAUTH_DROP_FS_SCOPE,
+				  (unsigned long)inside, 0, 0))
+				_exit(1);
+			_exit(0);
+		}
+		CHECK(waitpid(pid, &status, 0) == pid && WIFEXITED(status) && !WEXITSTATUS(status));
+	}
+	CHECK(!prctl(PR_CAPAUTH, PR_CAPAUTH_GET_CONFINED, 0, 0, 0));
+	return 0;
+}
+
+static int failure_atomicity(void)
+{
+	struct stat st;
+
+	DENIED(confine(1U << PR_CAPAUTH_FS_TRAVERSE), EOPNOTSUPP);
+	CHECK(!prctl(PR_CAPAUTH, PR_CAPAUTH_GET_CONFINED, 0, 0, 0));
+	DENIED(capop(datafd, F_RESTRICTFD_CAP, 0x80), EOPNOTSUPP);
+	CHECK(capop(datafd, F_GETFD_CAP, 0) == 3);
+	CHECK(!scope(inside, READ_SCOPE));
+	CHECK(!confine(1U << READ_SCOPE));
+	DENIED(scope(outside, READ_SCOPE), EPERM);
+	CHECK(!prctl(PR_CAPAUTH, PR_CAPAUTH_NORMAL, 0, 0, 0));
+	CHECK(prctl(PR_CAPAUTH, PR_CAPAUTH_GET_CONFINED, 0, 0, 0) == 1);
+	DENIED(openat(outside, "file", O_RDONLY), EACCES);
+	CHECK(!fstatat(outside, "file", &st, 0) && st.st_size == 4);
+	return 0;
+}
+
+static const struct {
+	const char *name;
+	int (*run)(void);
+} cases[] = {
+	{ "legacy syscall matrix", legacy },
+	{ "unhandled syscall matrix", unhandled },
+	{ "handled denied syscall matrix and failure state", denied },
+	{ "handled authorized syscall matrix", allowed },
+	{ "relative absolute symlink BENEATH IN_ROOT", resolution },
+	{ "scope follows object not pathname or reused descriptor", object_binding },
+	{ "bind mount and new mount namespace identity", mount_binding },
+	{ "restrict clone dup reuse no amplification", attenuation },
+	{ "SCM_RIGHTS and fork exec preserve bearer attenuation", bearer },
+	{ "Landlock denial independent of semantic grant", landlock_denial },
+	{ "parallel restriction clone and post-restriction denial", concurrency },
+	{ "unknown requests and irreversible confinement failure atomicity", failure_atomicity },
+	{ "mode-000 semantic READ grant and unhandled WRITE DAC denial", dac_grant },
+	{ "unhandled DAC denial with non-owner FSUID", dac_unhandled },
+	{ "ACL allow cannot exceed handled ceiling", acl_ceiling },
+	{ "managed mmap and mprotect cannot restore WRITE", mapping },
+	{ "unhandled O_TMPFILE retains Linux initial FD behavior", tmpfile_unhandled },
+	{ "read-only mount denies authorized creation", readonly_mount },
+	{ "clone races close and descriptor reuse", close_race },
+	{ "symlink exchange race cannot modify outside object", symlink_race },
+	{ "single-thread entry and task-local monotonic reductions", transitions },
+	{ "fork scope clone reduction destruction lifetime stress", credential_lifetime },
+};
+
+int main(int argc, char **argv)
+{
+	char directory[] = "/tmp/authority-matrix-XXXXXX", c;
+	unsigned int i;
+	int status, fd;
+	pid_t pid;
+
+	if (argc == 3 && !strcmp(argv[1], "--fd-probe")) {
+		fd = atoi(argv[2]);
+		CHECK(prctl(PR_CAPAUTH, PR_CAPAUTH_GET_CONFINED, 0, 0, 0) == 1);
+		CHECK(capop(fd, F_GETFD_CAP, 0) == 1);
+		CHECK(pread(fd, &c, 1, 0) == 1 && c == 'd');
+		DENIED(pwrite(fd, "!", 1, 0), EBADF);
+		return 0;
+	}
+	ksft_print_header();
+	if (geteuid() || prctl(PR_CAPAUTH, PR_CAPAUTH_GET_CONFINED, 0, 0, 0) != 0)
+		ksft_exit_skip("requires root in an unconfined disposable guest\n");
+	CHECK(mkdtemp(directory));
+	self = realpath(argv[0], NULL);
+	CHECK(self);
+	/* All mounts and filesystem changes are private to this process tree. */
+	CHECK(!unshare(CLONE_NEWNS));
+	CHECK(!mount(NULL, "/", NULL, MS_REC | MS_PRIVATE, NULL));
+	ksft_set_plan(ARRAY_SIZE(cases));
+	for (i = 0; i < ARRAY_SIZE(cases); i++) {
+		CHECK(!mount(TEST_FS, directory, TEST_FS, 0, "mode=0700"));
+		rootfd = open(directory, O_PATH | O_DIRECTORY);
+		CHECK(rootfd >= 0);
+		CHECK(!mkdirat(rootfd, "in", 0700) && !mkdirat(rootfd, "out", 0700));
+		inside = openat(rootfd, "in", O_PATH | O_DIRECTORY);
+		outside = openat(rootfd, "out", O_PATH | O_DIRECTORY);
+		CHECK(inside >= 0 && outside >= 0);
+		datafd = openat(inside, "file", O_CREAT | O_RDWR, 0600);
+		CHECK(datafd >= 0 && write(datafd, "data", 4) == 4);
+		fd = openat(outside, "file", O_CREAT | O_RDWR, 0600);
+		CHECK(fd >= 0 && write(fd, "data", 4) == 4);
+		close(fd);
+		fd = openat(inside, "victim", O_CREAT | O_RDWR, 0600);
+		CHECK(fd >= 0);
+		close(fd);
+		pid = fork();
+		CHECK(pid >= 0);
+		if (!pid)
+			_exit(cases[i].run());
+		CHECK(waitpid(pid, &status, 0) == pid);
+		if (WIFEXITED(status) && WEXITSTATUS(status) == KSFT_SKIP)
+			ksft_test_result_skip("%s\n", cases[i].name);
+		else
+			ksft_test_result(WIFEXITED(status) && !WEXITSTATUS(status),
+					 "%s\n", cases[i].name);
+		close(datafd);
+		close(inside);
+		close(outside);
+		close(rootfd);
+		CHECK(!umount2(directory, MNT_DETACH));
+	}
+	CHECK(!rmdir(directory));
+	free((void *)self);
+	ksft_finished();
+}
