+static int mapping(void)
+{
+	void *p;
+	struct stat st;
+
+	CHECK(!capop(datafd, F_RESTRICTFD_CAP, 1));
+	p = mmap(NULL, 4096, PROT_READ | PROT_WRITE, MAP_SHARED, datafd, 0);
+	CHECK(p == MAP_FAILED && errno == EACCES);
+	p = mmap(NULL, 4096, PROT_READ, MAP_SHARED, datafd, 0);
+	CHECK(p != MAP_FAILED);
+	DENIED(mprotect(p, 4096, PROT_READ | PROT_WRITE), EACCES);
+	CHECK(!munmap(p, 4096));
+	CHECK(!fstat(datafd, &st) && st.st_size == 4);
+	return 0;
+}
