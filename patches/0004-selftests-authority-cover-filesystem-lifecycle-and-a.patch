diff --git a/tools/testing/selftests/authority/authority_test.c b/tools/testing/selftests/authority/authority_test.c
new file mode 100644
index 0000000000000000000000000000000000000000..2320ec07cc759cf00130d14302e13b27ab19037e
--- /dev/null
+++ b/tools/testing/selftests/authority/authority_test.c
@@ -0,0 +1,549 @@
+// SPDX-License-Identifier: GPL-2.0
+#define _GNU_SOURCE
+#include <errno.h>
+#include <fcntl.h>
+#ifndef F_LINUX_SPECIFIC_BASE
+#define F_LINUX_SPECIFIC_BASE 1024
+#endif
+#define _ASM_GENERIC_FCNTL_H
+#include <linux/fcntl.h>
+#include <linux/prctl.h>
+#include <limits.h>
+#include <stdint.h>
+#include <stdio.h>
+#include <stdlib.h>
+#include <string.h>
+#include <sys/prctl.h>
+#include <sys/stat.h>
+#include <sys/types.h>
+#include <sys/wait.h>
+#include <unistd.h>
+
+#include "../kselftest.h"
+
+#define CASE_SKIP 77
+#define FILE_CONTENT "authority-selftest-data"
+
+struct fixture {
+	char path[PATH_MAX];
+	int dirfd;
+	int oldfd;
+	int newfd;
+};
+
+struct scope_request {
+	int fd;
+	unsigned int right;
+};
+
+static char self_exe[PATH_MAX];
+
+typedef int (*case_fn)(const struct fixture *fixture);
+
+static int add_scope(int fd, unsigned int right)
+{
+	if (prctl(PR_CAPAUTH, PR_CAPAUTH_ADD_FS_SCOPE,
+		  (unsigned long)fd, right, 0) == 0)
+		return 0;
+	if (errno == EPERM || errno == EACCES)
+		return CASE_SKIP;
+	return -1;
+}
+
+static int enter_domain(unsigned char handled,
+			const struct scope_request *scopes, size_t nr_scopes)
+{
+	union {
+		uint64_t alignment;
+		unsigned char data[sizeof(struct pr_capauth_confine) + 1];
+	} request_storage = {};
+	struct pr_capauth_confine *request = (void *)request_storage.data;
+	size_t i;
+
+	for (i = 0; i < nr_scopes; i++) {
+		int error = add_scope(scopes[i].fd, scopes[i].right);
+
+		if (error)
+			return error;
+	}
+	request->size = sizeof(request_storage.data);
+	request->version = PR_CAPAUTH_CONFINE_VERSION_1;
+	request->handled[0] = handled;
+	if (prctl(PR_CAPAUTH, PR_CAPAUTH_CONFINE,
+		  (unsigned long)request, 0, 0) == 0)
+		return 0;
+	return -1;
+}
+
+static int skip_unless_root(void)
+{
+	return geteuid() == 0 ? 0 : CASE_SKIP;
+}
+
+static int drop_to_unprivileged(void)
+{
+	if (setgid(65534) || setuid(65534))
+		return CASE_SKIP;
+	return 0;
+}
+
+static int expect_errno(int result, int expected)
+{
+	return result == -1 && errno == expected ? 0 : -1;
+}
+
+static int case_unhandled_write(const struct fixture *fixture)
+{
+	int fd;
+
+	if (skip_unless_root())
+		return CASE_SKIP;
+	if (enter_domain(1U << PR_CAPAUTH_FS_READ_FILE, NULL, 0))
+		return 1;
+	fd = openat(fixture->dirfd, "file", O_WRONLY);
+	if (fd < 0)
+		return 1;
+	close(fd);
+	return 0;
+}
+
+static int case_handled_read_ceiling(const struct fixture *fixture)
+{
+	int fd;
+
+	if (skip_unless_root())
+		return CASE_SKIP;
+	if (enter_domain(1U << PR_CAPAUTH_FS_READ_FILE, NULL, 0))
+		return 1;
+	fd = openat(fixture->dirfd, "file", O_RDONLY);
+	if (expect_errno(fd, EACCES)) {
+		if (fd >= 0)
+			close(fd);
+		return 1;
+	}
+	return 0;
+}
+
+static int case_scoped_read_grant(const struct fixture *fixture)
+{
+	const struct scope_request scopes[] = {
+		{ fixture->dirfd, PR_CAPAUTH_FS_READ_FILE },
+	};
+	char buffer[sizeof(FILE_CONTENT)];
+	int error, fd;
+
+	error = enter_domain(1U << PR_CAPAUTH_FS_READ_FILE, scopes,
+			     ARRAY_SIZE(scopes));
+	if (error)
+		return error == CASE_SKIP ? CASE_SKIP : 1;
+	if (drop_to_unprivileged())
+		return CASE_SKIP;
+	fd = openat(fixture->dirfd, "file", O_RDONLY);
+	if (fd < 0)
+		return 1;
+	error = read(fd, buffer, sizeof(FILE_CONTENT) - 1) ==
+			sizeof(FILE_CONTENT) - 1 &&
+			!memcmp(buffer, FILE_CONTENT, sizeof(FILE_CONTENT) - 1) ? 0 : 1;
+	close(fd);
+	return error;
+}
+
+static int case_create_does_not_mint_write(const struct fixture *fixture)
+{
+	const struct scope_request scopes[] = {
+		{ fixture->dirfd, PR_CAPAUTH_FS_CREATE_FILE },
+	};
+	int fd, error;
+	struct stat st;
+
+	error = enter_domain((1U << PR_CAPAUTH_FS_CREATE_FILE) |
+			     (1U << PR_CAPAUTH_FS_WRITE_FILE), scopes,
+			     ARRAY_SIZE(scopes));
+	if (error)
+		return error == CASE_SKIP ? CASE_SKIP : 1;
+	if (drop_to_unprivileged())
+		return CASE_SKIP;
+	fd = openat(fixture->dirfd, "new", O_CREAT | O_EXCL | O_WRONLY, 0600);
+	if (expect_errno(fd, EACCES)) {
+		if (fd >= 0)
+			close(fd);
+		return 1;
+	}
+	return fstatat(fixture->dirfd, "new", &st, AT_SYMLINK_NOFOLLOW) == -1 &&
+		errno == ENOENT ? 0 : 1;
+}
+
+static int case_create_and_write_scopes(const struct fixture *fixture)
+{
+	const struct scope_request scopes[] = {
+		{ fixture->dirfd, PR_CAPAUTH_FS_CREATE_FILE },
+		{ fixture->dirfd, PR_CAPAUTH_FS_WRITE_FILE },
+	};
+	int error, fd;
+
+	error = enter_domain((1U << PR_CAPAUTH_FS_CREATE_FILE) |
+			     (1U << PR_CAPAUTH_FS_WRITE_FILE), scopes,
+			     ARRAY_SIZE(scopes));
+	if (error)
+		return error == CASE_SKIP ? CASE_SKIP : 1;
+	if (drop_to_unprivileged())
+		return CASE_SKIP;
+	fd = openat(fixture->dirfd, "new", O_CREAT | O_EXCL | O_WRONLY, 0600);
+	if (fd < 0)
+		return 1;
+	error = write(fd, FILE_CONTENT, sizeof(FILE_CONTENT) - 1) ==
+			sizeof(FILE_CONTENT) - 1 ? 0 : 1;
+	close(fd);
+	return error;
+}
+
+static int case_path_truncate_write_ceiling(const struct fixture *fixture)
+{
+	char path[PATH_MAX];
+
+	if (skip_unless_root())
+		return CASE_SKIP;
+	if (enter_domain(1U << PR_CAPAUTH_FS_WRITE_FILE, NULL, 0))
+		return 1;
+	if (snprintf(path, sizeof(path), "%s/file", fixture->path) >=
+	    sizeof(path))
+		return 1;
+	return expect_errno(truncate(path, 0), EACCES) ? 1 : 0;
+}
+
+static int case_fd_survives_scope_drop(const struct fixture *fixture)
+{
+	const struct scope_request scopes[] = {
+		{ fixture->dirfd, PR_CAPAUTH_FS_WRITE_FILE },
+	};
+	int error, fd;
+
+	error = enter_domain(1U << PR_CAPAUTH_FS_WRITE_FILE, scopes,
+			     ARRAY_SIZE(scopes));
+	if (error)
+		return error == CASE_SKIP ? CASE_SKIP : 1;
+	fd = openat(fixture->dirfd, "file", O_WRONLY);
+	if (fd < 0)
+		return 1;
+	if (prctl(PR_CAPAUTH, PR_CAPAUTH_DROP_FS_SCOPE_RIGHT,
+		  (unsigned long)fixture->dirfd, PR_CAPAUTH_FS_WRITE_FILE, 0)) {
+		close(fd);
+		return 1;
+	}
+	if (write(fd, "x", 1) != 1) {
+		close(fd);
+		return 1;
+	}
+	close(fd);
+	return 0;
+}
+
+static int unlink_cap(int dirfd, const char *name)
+{
+	return prctl(PR_CAPAUTH, PR_CAPAUTH_UNLINKAT, (unsigned long)dirfd,
+		     (unsigned long)name, 0);
+}
+
+static int case_delete_missing_scope(const struct fixture *fixture)
+{
+	if (skip_unless_root())
+		return CASE_SKIP;
+	if (enter_domain(1U << PR_CAPAUTH_FS_DELETE_FILE, NULL, 0))
+		return 1;
+	return expect_errno(unlink_cap(fixture->dirfd, "victim"), EACCES) ?
+		1 : 0;
+}
+
+static int case_delete_exact_scope(const struct fixture *fixture)
+{
+	const struct scope_request scopes[] = {
+		{ fixture->dirfd, PR_CAPAUTH_FS_DELETE_FILE },
+	};
+	int error;
+
+	error = enter_domain(1U << PR_CAPAUTH_FS_DELETE_FILE, scopes,
+			     ARRAY_SIZE(scopes));
+	if (error)
+		return error == CASE_SKIP ? CASE_SKIP : 1;
+	if (drop_to_unprivileged())
+		return CASE_SKIP;
+	return unlink_cap(fixture->dirfd, "victim") == 0 ? 0 : 1;
+}
+
+static int rename_cap(int oldfd, int newfd, const char *oldname,
+		      const char *newname)
+{
+	struct pr_capauth_renameat2 request = {
+		.olddirfd = oldfd,
+		.newdirfd = newfd,
+		.oldname = (uintptr_t)oldname,
+		.newname = (uintptr_t)newname,
+	};
+
+	return prctl(PR_CAPAUTH, PR_CAPAUTH_RENAMEAT2,
+		     (unsigned long)&request, 0, 0);
+}
+
+static int case_rename_requires_both_parents(const struct fixture *fixture)
+{
+	const struct scope_request scopes[] = {
+		{ fixture->oldfd, PR_CAPAUTH_FS_RENAME },
+	};
+	int error;
+
+	if (fixture->oldfd < 0 || fixture->newfd < 0)
+		return 1;
+	if (skip_unless_root())
+		return CASE_SKIP;
+	error = enter_domain(1U << PR_CAPAUTH_FS_RENAME, scopes,
+			     ARRAY_SIZE(scopes));
+	if (error)
+		return error == CASE_SKIP ? CASE_SKIP : 1;
+	return expect_errno(rename_cap(fixture->oldfd, fixture->newfd,
+				       "source", "target"), EACCES) ? 1 : 0;
+}
+
+static int case_rename_scoped_both_parents(const struct fixture *fixture)
+{
+	const struct scope_request scopes[] = {
+		{ fixture->oldfd, PR_CAPAUTH_FS_RENAME },
+		{ fixture->newfd, PR_CAPAUTH_FS_RENAME },
+	};
+	int error;
+
+	if (fixture->oldfd < 0 || fixture->newfd < 0)
+		return 1;
+	error = enter_domain(1U << PR_CAPAUTH_FS_RENAME, scopes,
+			     ARRAY_SIZE(scopes));
+	if (error)
+		return error == CASE_SKIP ? CASE_SKIP : 1;
+	if (drop_to_unprivileged())
+		return CASE_SKIP;
+	return rename_cap(fixture->oldfd, fixture->newfd,
+			  "source", "target") == 0 ? 0 : 1;
+}
+
+static int case_fd_attenuation(const struct fixture *fixture)
+{
+	const struct scope_request scopes[] = {
+		{ fixture->dirfd, PR_CAPAUTH_FS_READ_FILE },
+		{ fixture->dirfd, PR_CAPAUTH_FS_WRITE_FILE },
+	};
+	union {
+		uint64_t alignment;
+		unsigned char data[sizeof(struct fd_cap_request) + 1];
+	} request_storage = {};
+	struct fd_cap_request *request = (void *)request_storage.data;
+	char buffer[sizeof(FILE_CONTENT)];
+	int error, fd;
+
+	error = enter_domain((1U << PR_CAPAUTH_FS_READ_FILE) |
+			     (1U << PR_CAPAUTH_FS_WRITE_FILE), scopes,
+			     ARRAY_SIZE(scopes));
+	if (error)
+		return error == CASE_SKIP ? CASE_SKIP : 1;
+	fd = openat(fixture->dirfd, "file", O_RDWR);
+	if (fd < 0)
+		return 1;
+	request->size = sizeof(request_storage.data);
+	request->version = FD_CAP_VERSION_1;
+	request->rights[0] = 1U << FD_CAP_READ;
+	if (fcntl(fd, F_RESTRICTFD_CAP, request)) {
+		close(fd);
+		return 1;
+	}
+	request->rights[0] = 0;
+	if (fcntl(fd, F_GETFD_CAP, request) ||
+	    request->rights[0] != (1U << FD_CAP_READ)) {
+		close(fd);
+		return 1;
+	}
+	if (expect_errno(write(fd, "x", 1), EBADF)) {
+		close(fd);
+		return 1;
+	}
+	if (lseek(fd, 0, SEEK_SET) < 0 ||
+	    read(fd, buffer, sizeof(FILE_CONTENT) - 1) !=
+			sizeof(FILE_CONTENT) - 1) {
+		close(fd);
+		return 1;
+	}
+	close(fd);
+	return 0;
+}
+
+static int exec_probe_read(int dirfd)
+{
+	int fd = openat(dirfd, "file", O_RDONLY);
+
+	if (fd >= 0) {
+		close(fd);
+		return 1;
+	}
+	return errno == EACCES ? 0 : 1;
+}
+
+static int case_fork_exec_inheritance(const struct fixture *fixture)
+{
+	pid_t child;
+	int status;
+	char fd_string[32];
+
+	if (skip_unless_root())
+		return CASE_SKIP;
+	if (enter_domain(1U << PR_CAPAUTH_FS_READ_FILE, NULL, 0))
+		return 1;
+	child = fork();
+	if (child < 0)
+		return 1;
+	if (!child) {
+		int length = snprintf(fd_string, sizeof(fd_string), "%d",
+				      fixture->dirfd);
+
+		if (length < 0 || (size_t)length >= sizeof(fd_string))
+			_exit(127);
+		execl(self_exe, self_exe, "--probe-read", fd_string,
+		      (char *)NULL);
+		_exit(127);
+	}
+	if (waitpid(child, &status, 0) != child || !WIFEXITED(status))
+		return 1;
+	return WEXITSTATUS(status) == 0 ? 0 : 1;
+}
+
+static int fixture_create(struct fixture *fixture, unsigned int index)
+{
+	char template[PATH_MAX];
+	int fd;
+
+	memset(fixture, 0, sizeof(*fixture));
+	fixture->dirfd = fixture->oldfd = fixture->newfd = -1;
+	if (snprintf(template, sizeof(template), "/tmp/capauth-%ld-%u-XXXXXX",
+		     (long)getpid(), index) >= sizeof(template))
+		return -1;
+	if (!mkdtemp(template))
+		return -1;
+	strcpy(fixture->path, template);
+	if (chmod(fixture->path, 0711))
+		return -1;
+	fixture->dirfd = open(fixture->path, O_PATH | O_DIRECTORY);
+	if (fixture->dirfd < 0)
+		return -1;
+	fd = openat(fixture->dirfd, "file", O_CREAT | O_EXCL | O_RDWR, 0600);
+	if (fd < 0)
+		return -1;
+	if (write(fd, FILE_CONTENT, sizeof(FILE_CONTENT) - 1) !=
+	    sizeof(FILE_CONTENT) - 1 || fchmod(fd, 0000)) {
+		close(fd);
+		return -1;
+	}
+	close(fd);
+	fd = openat(fixture->dirfd, "victim", O_CREAT | O_EXCL | O_RDWR, 0600);
+	if (fd < 0)
+		return -1;
+	close(fd);
+	if (mkdirat(fixture->dirfd, "old", 0711) ||
+	    mkdirat(fixture->dirfd, "newdir", 0711))
+		return -1;
+	fixture->oldfd = openat(fixture->dirfd, "old", O_PATH | O_DIRECTORY);
+	fixture->newfd = openat(fixture->dirfd, "newdir", O_PATH | O_DIRECTORY);
+	if (fixture->oldfd < 0 || fixture->newfd < 0)
+		return -1;
+	fd = openat(fixture->oldfd, "source", O_CREAT | O_EXCL | O_RDWR, 0600);
+	if (fd < 0)
+		return -1;
+	close(fd);
+	return 0;
+}
+
+static void fixture_destroy(struct fixture *fixture)
+{
+	if (fixture->oldfd >= 0)
+		close(fixture->oldfd);
+	if (fixture->newfd >= 0)
+		close(fixture->newfd);
+	if (fixture->dirfd >= 0) {
+		unlinkat(fixture->dirfd, "file", 0);
+		unlinkat(fixture->dirfd, "new", 0);
+		unlinkat(fixture->dirfd, "victim", 0);
+		unlinkat(fixture->dirfd, "old/source", 0);
+		unlinkat(fixture->dirfd, "newdir/target", 0);
+		unlinkat(fixture->dirfd, "old", AT_REMOVEDIR);
+		unlinkat(fixture->dirfd, "newdir", AT_REMOVEDIR);
+		close(fixture->dirfd);
+	}
+	if (fixture->path[0])
+		rmdir(fixture->path);
+}
+
+static void run_case(unsigned int index, const char *name, case_fn function)
+{
+	struct fixture fixture;
+	pid_t child;
+	int status, result;
+
+	if (fixture_create(&fixture, index)) {
+		fixture_destroy(&fixture);
+		ksft_test_result_fail("%s (fixture setup)\n", name);
+		return;
+	}
+	child = fork();
+	if (child == 0)
+		_exit(function(&fixture));
+	if (child < 0 || waitpid(child, &status, 0) != child) {
+		fixture_destroy(&fixture);
+		ksft_test_result_fail("%s (fork/wait)\n", name);
+		return;
+	}
+	result = WIFEXITED(status) ? WEXITSTATUS(status) : 1;
+	fixture_destroy(&fixture);
+	if (result == CASE_SKIP)
+		ksft_test_result_skip("%s (requires CAP_SYS_ADMIN or setuid)\n",
+				      name);
+	else if (result)
+		ksft_test_result_fail("%s\n", name);
+	else
+		ksft_test_result_pass("%s\n", name);
+}
+
+int main(int argc, char **argv)
+{
+	if (argc == 3 && !strcmp(argv[1], "--probe-read"))
+		return exec_probe_read(atoi(argv[2]));
+	if (argc > 1)
+		return 2;
+	if (!realpath(argv[0], self_exe))
+		return 2;
+	if (prctl(PR_CAPAUTH, PR_CAPAUTH_GET_CONFINED, 0, 0, 0) < 0)
+		ksft_exit_skip("kernel lacks PR_CAPAUTH support\n");
+
+	ksft_print_header();
+	ksft_set_plan(13);
+	run_case(1, "unhandled WRITE retains legacy DAC behavior",
+		 case_unhandled_write);
+	run_case(2, "handled READ ceiling denies without scope despite root DAC",
+		 case_handled_read_ceiling);
+	run_case(3, "scoped READ grants mode-000 file after dropping DAC privilege",
+		 case_scoped_read_grant);
+	run_case(4, "CREATE alone does not mint initial WRITE authority",
+		 case_create_does_not_mint_write);
+	run_case(5, "separate CREATE and WRITE scopes permit initial writable FD",
+		 case_create_and_write_scopes);
+	run_case(6, "path truncate is a fresh handled WRITE request",
+		 case_path_truncate_write_ceiling);
+	run_case(7, "established writable FD survives scope-right drop",
+		 case_fd_survives_scope_drop);
+	run_case(8, "DELETE without exact-parent scope is denied",
+		 case_delete_missing_scope);
+	run_case(9, "exact-parent DELETE scope permits unlink",
+		 case_delete_exact_scope);
+	run_case(10, "RENAME requires both exact parent scopes",
+		 case_rename_requires_both_parents);
+	run_case(11, "two exact-parent RENAME scopes permit regular-file rename",
+		 case_rename_scoped_both_parents);
+	run_case(12, "FD restriction removes WRITE without removing READ",
+		 case_fd_attenuation);
+	run_case(13, "fork and exec preserve handled confinement",
+		 case_fork_exec_inheritance);
+	ksft_finished();
+}
diff --git a/tools/testing/selftests/authority/callback_test.c b/tools/testing/selftests/authority/callback_test.c
new file mode 100644
index 0000000000000000000000000000000000000000..4bdb1c5daed2df576e9f189eb4622346f458ff0b
--- /dev/null
+++ b/tools/testing/selftests/authority/callback_test.c
@@ -0,0 +1,125 @@
+// SPDX-License-Identifier: GPL-2.0
+#define _GNU_SOURCE
+#include <errno.h>
+#include <fcntl.h>
+#define _ASM_GENERIC_FCNTL_H
+#define F_LINUX_SPECIFIC_BASE 1024
+#include <linux/fcntl.h>
+#include <linux/mount.h>
+#include <linux/prctl.h>
+#include <linux/posix_acl_xattr.h>
+#include <sched.h>
+#include <signal.h>
+#include <stdint.h>
+#include <stdio.h>
+#include <stdlib.h>
+#include <string.h>
+#include <sys/mount.h>
+#include <sys/prctl.h>
+#include <sys/stat.h>
+#include <sys/syscall.h>
+#include <sys/wait.h>
+#include <sys/xattr.h>
+#include <unistd.h>
+#include "../kselftest.h"
+#define CHECK(c) do { if (!(c)) { dprintf(2,"# %s:%d %s errno=%d\n",__func__,__LINE__,#c,errno); return 1; } } while (0)
+static int api, managed, plain, mapped, dfd, ofd;
+static char base[128], mpath[160];
+static int capop(int fd,int op,unsigned char bits)
+{
+ union {uint64_t align;unsigned char bytes[sizeof(struct fd_cap_request)+1];} s={};
+ struct fd_cap_request *r=(void *)s.bytes;
+ r->size=sizeof(s.bytes);r->version=FD_CAP_VERSION_1;r->rights[0]=bits;
+ int rc=fcntl(fd,op,r);
+ return !rc&&op==F_GETFD_CAP?r->rights[0]:rc;
+}
+static int confine(unsigned char mask)
+{
+ if(!managed)return 0;
+ union {uint64_t align;unsigned char bytes[sizeof(struct pr_capauth_confine)+1];} s={};
+ struct pr_capauth_confine *r=(void *)s.bytes;
+ r->size=sizeof(s.bytes);r->version=PR_CAPAUTH_CONFINE_VERSION_1;r->handled[0]=mask;
+ return prctl(PR_CAPAUTH,PR_CAPAUTH_CONFINE,(unsigned long)r,0UL,0UL);
+}
+static int scope(int fd,int right)
+{
+ return managed?prctl(PR_CAPAUTH,PR_CAPAUTH_ADD_FS_SCOPE,(unsigned long)fd,(unsigned long)right,0UL):0;
+}
+static int setup(void)
+{
+ char lower[180],upper[180],work[180],opts[700];int fd;
+ CHECK(!unshare(CLONE_NEWNS)&&!mount(NULL,"/",NULL,MS_REC|MS_PRIVATE,NULL));
+ strcpy(base,"/tmp/authority-ovl.XXXXXX");CHECK(mkdtemp(base)&&!chmod(base,0755));
+ snprintf(lower,sizeof(lower),"%s/lower",base);snprintf(upper,sizeof(upper),"%s/upper",base);
+ snprintf(work,sizeof(work),"%s/work",base);snprintf(mpath,sizeof(mpath),"%s/merged",base);
+ CHECK(!mkdir(lower,0755)&&!mkdir(upper,0755)&&!mkdir(work,0755)&&!mkdir(mpath,0755));
+ plain=open(lower,O_PATH|O_DIRECTORY);CHECK(plain>=0);
+ fd=openat(plain,"denied",O_CREAT|O_RDWR,0000);CHECK(fd>=0&&write(fd,"data",4)==4);close(fd);
+ fd=openat(plain,"allowed",O_CREAT|O_RDWR,0444);CHECK(fd>=0&&write(fd,"data",4)==4);close(fd);
+ CHECK(!mkdirat(plain,"deny-dir",0555)&&!mkdirat(plain,"allow-dir",0777));
+ CHECK(!fchmodat(plain,"allow-dir",0777,0));
+ snprintf(opts,sizeof(opts),"lowerdir=%s,upperdir=%s,workdir=%s",lower,upper,work);
+ CHECK(!mount("overlay",mpath,"overlay",0,opts));
+ mapped=open(mpath,O_PATH|O_DIRECTORY);CHECK(mapped>=0);
+ dfd=openat(mapped,"deny-dir",O_PATH|O_DIRECTORY);ofd=openat(mapped,"allow-dir",O_PATH|O_DIRECTORY);CHECK(dfd>=0&&ofd>=0);
+ return 0;
+}
+static int drop(void){return setgid(1000)||setuid(1000);}
+static int data(void)
+{
+ int fd,source;char c;
+ CHECK(!setup());source=openat(mapped,"denied",O_RDWR);CHECK(source>=0);
+ CHECK(!scope(mapped,PR_CAPAUTH_FS_READ_FILE)&&!scope(mapped,PR_CAPAUTH_FS_WRITE_FILE));
+ CHECK(!confine(0x18)&&!drop());
+ errno=0;CHECK(openat(mapped,"denied",O_RDONLY)==-1&&errno==EACCES);
+ fd=openat(mapped,"allowed",O_RDONLY);CHECK(fd>=0&&read(fd,&c,1)==1&&c=='d');
+ CHECK(pread(source,&c,1,0)==1&&c=='d');
+ if(managed){
+  errno=0;CHECK(capop(source,F_GETFD_CAP,0)==-1&&errno==EOPNOTSUPP);
+  errno=0;CHECK(capop(source,F_CLONEFD_CAP,1)==-1&&errno==EOPNOTSUPP);
+  errno=0;CHECK(capop(source,F_RESTRICTFD_CAP,1)==-1&&errno==EOPNOTSUPP);
+ }
+ return 0;
+}
+static int namespace_ops(void)
+{
+ int fd;struct stat st;
+ CHECK(!setup());
+ for(int r=1;r<=7;r++){
+  if(r==2)continue;
+  CHECK(!scope(ofd,r));
+  if(r==1||r==3||r==4)CHECK(!scope(mapped,r));
+ }
+ CHECK(!confine(0xfa)&&!drop());
+ errno=0;CHECK(openat(dfd,"new",O_CREAT|O_RDWR,0600)==-1&&errno==EACCES);
+ CHECK(fstatat(dfd,"new",&st,0)==-1&&errno==ENOENT);
+ fd=openat(ofd,"new",O_CREAT|O_RDWR,0600);CHECK(fd>=0&&write(fd,"data",4)==4);
+ CHECK(!linkat(ofd,"new",ofd,"alias",0));
+ CHECK(!syscall(SYS_renameat2,ofd,"new",ofd,"renamed",RENAME_NOREPLACE));
+ CHECK(!unlinkat(ofd,"alias",0)&&!unlinkat(ofd,"renamed",0));
+ CHECK(!ftruncate(fd,1));return 0;
+}
+int main(void)
+{
+ const struct {const char *name;int (*run)(void);int mode;} cases[]={
+ {"native overlay callback DAC and established FD",data,0},
+ {"handled grants cannot override callback; FD cap API unsupported",data,1},
+ {"native overlay namespace permission and lifetime",namespace_ops,0},
+ {"handled overlay namespace grants retain callback denial",namespace_ops,1}};
+ int rc,status;pid_t pid;
+ setvbuf(stdout,NULL,_IONBF,0);ksft_print_header();if(geteuid())ksft_exit_skip("requires isolated root guest\n");
+ errno=0;rc=prctl(PR_CAPAUTH,PR_CAPAUTH_GET_CONFINED,0UL,0UL,0UL);
+ if(rc==-1&&errno!=EINVAL)ksft_exit_fail_msg("Authority query error %d\n",errno);
+ if(rc>0)ksft_exit_fail_msg("requires initially unconfined process\n");
+ api=rc==0;
+ pid=fork();CHECK(pid>=0);if(!pid)_exit(unshare(CLONE_NEWNS)?4:0);
+ CHECK(waitpid(pid,&status,0)==pid);
+ if(!WIFEXITED(status)||WEXITSTATUS(status))ksft_exit_skip("privileged mount namespace setup unavailable\n");
+ ksft_set_plan(ARRAY_SIZE(cases));
+ for(unsigned i=0;i<ARRAY_SIZE(cases);i++){
+  if(cases[i].mode&&!api){ksft_test_result_skip("%s (custom API unavailable)\n",cases[i].name);continue;}
+  managed=cases[i].mode;pid=fork();CHECK(pid>=0);if(!pid)_exit(cases[i].run());
+  CHECK(waitpid(pid,&status,0)==pid);ksft_test_result(WIFEXITED(status)&&!WEXITSTATUS(status),"%s\n",cases[i].name);
+ }
+ ksft_finished();
+}
