+ else{CHECK(m->fd>=0&&read(m->fd,&c,1)==1&&c=='d');if(variant==1){CHECK(capop(m->fd,F_GETFD_CAP,0)==1&&!capop(m->fd,F_RESTRICTFD_CAP,0));errno=0;CHECK(read(m->fd,&c,1)==-1&&errno==EBADF);}}
+ CHECK(waitpid(child,&status,0)==child&&WIFEXITED(status)&&!WEXITSTATUS(status));return 0;
+}
+struct ring {int fd;struct io_uring_params p;void *sq,*cq;struct io_uring_sqe *sqes;};
+static int ring_setup(struct ring*r)
+{
+ memset(r,0,sizeof(*r));r->fd=syscall(SYS_io_uring_setup,4,&r->p);CHECK(r->fd>=0);
+ size_t ss=r->p.sq_off.array+r->p.sq_entries*sizeof(unsigned),cs=r->p.cq_off.cqes+r->p.cq_entries*sizeof(struct io_uring_cqe);
+ if(r->p.features&IORING_FEAT_SINGLE_MMAP){if(cs>ss)ss=cs;r->sq=mmap(0,ss,PROT_READ|PROT_WRITE,MAP_SHARED,r->fd,IORING_OFF_SQ_RING);r->cq=r->sq;}
+ else{r->sq=mmap(0,ss,PROT_READ|PROT_WRITE,MAP_SHARED,r->fd,IORING_OFF_SQ_RING);r->cq=mmap(0,cs,PROT_READ|PROT_WRITE,MAP_SHARED,r->fd,IORING_OFF_CQ_RING);}
