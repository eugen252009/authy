+#define CHECK(c) do {if(!(c)){dprintf(2,"# %s:%d %s errno=%d\n",__func__,__LINE__,#c,errno);return 1;}} while(0)
+static int api,variant;static char dir[100],path[150];static int rootfd;
+static int capop(int fd,int op,int bits)
+{
+ union{uint64_t align;unsigned char b[sizeof(struct fd_cap_request)+1];}s={};
+ struct fd_cap_request*r=(void*)s.b;r->size=sizeof(s.b);r->version=FD_CAP_VERSION_1;r->rights[0]=bits;
+ int rc=fcntl(fd,op,r);return !rc&&op==F_GETFD_CAP?r->rights[0]:rc;
+}
+static int setup(void)
+{
+ int fd;strcpy(dir,"/tmp/authority-est.XXXXXX");CHECK(mkdtemp(dir));rootfd=open(dir,O_PATH|O_DIRECTORY);CHECK(rootfd>=0);
+ snprintf(path,sizeof(path),"%s/file",dir);fd=open(path,O_CREAT|O_RDWR,0600);CHECK(fd>=0&&write(fd,"data",4)==4);close(fd);return 0;
+}
+static int enter(unsigned char mask)
+{
+ union{uint64_t a;unsigned char b[sizeof(struct pr_capauth_confine)+1];}s={};
+ struct pr_capauth_confine*r=(void*)s.b;r->size=sizeof(s.b);r->version=PR_CAPAUTH_CONFINE_VERSION_1;r->handled[0]=mask;
+ return prctl(PR_CAPAUTH,PR_CAPAUTH_CONFINE,(unsigned long)r,0UL,0UL);
+}
+static int groups(void)
+{
+ int fd;gid_t group=1001;CHECK(!setup()&&!chmod(dir,0755));CHECK(!chown(path,0,1001)&&!chmod(path,0040));
+ if(variant)CHECK(!enter(0));
+ CHECK(!setgroups(1,&group)&&!setgid(1002)&&!setuid(1002));
+ fd=open(path,O_RDONLY);CHECK(fd>=0);errno=0;CHECK(open(path,O_WRONLY)==-1&&errno==EACCES);return 0;
+}
+static int fsidentity(void)
+{
+ int fd;CHECK(!setup()&&!chmod(dir,0755));CHECK(!chmod(path,0000));
+ if(variant)CHECK(!prctl(PR_CAPAUTH,PR_CAPAUTH_ADD_FS_SCOPE,(unsigned long)rootfd,(unsigned long)PR_CAPAUTH_FS_READ_FILE,0UL));
+ if(variant==2)CHECK(!enter(0x18));else if(variant==1)CHECK(!enter(0));
+ setfsgid(1002);setfsuid(1002);CHECK(setfsuid((uid_t)-1)==1002);
+ errno=0;fd=open(path,O_RDONLY);
+ if(variant)CHECK(fd>=0);else CHECK(fd==-1&&errno==EACCES);
+ errno=0;CHECK(open(path,O_WRONLY)==-1&&errno==EACCES);return 0;
+}
+static int owner_ceiling(void)
+{
+ CHECK(!setup()&&!chmod(path,0666)&&!enter(0x18));
+ errno=0;CHECK(open(path,O_RDWR)==-1&&errno==EACCES);return 0;
+}
+static int transfer(void)
+{
+ int src,dst,pipefd[2];char target[150],c;
+ CHECK(!setup());src=open(path,O_RDWR);CHECK(src>=0);
+ snprintf(target,sizeof(target),"%s/destination",dir);dst=open(target,O_CREAT|O_RDWR,0600);CHECK(dst>=0);
+ CHECK(write(dst,"data",4)==4&&!pipe(pipefd));
+ if(variant==0)CHECK(!capop(src,F_RESTRICTFD_CAP,1));
+ if(variant==1)CHECK(!capop(src,F_RESTRICTFD_CAP,0));
+ if(variant==2)CHECK(!capop(dst,F_RESTRICTFD_CAP,1));
+ off_t a=0,b=0;ssize_t n;
+ errno=0;n=sendfile(dst,src,&a,1);
+ if(!variant)CHECK(n==1);else CHECK(n==-1&&(errno==EBADF||errno==EACCES));
+ a=b=0;errno=0;n=copy_file_range(src,&a,dst,&b,1,0);
+ if(!variant)CHECK(n==1);else CHECK(n==-1&&(errno==EBADF||errno==EACCES));
+ a=0;errno=0;n=splice(src,&a,pipefd[1],NULL,1,0);
+ if(variant==1)CHECK(n==-1&&(errno==EBADF||errno==EACCES));
+ else {
+  CHECK(n==1);b=0;errno=0;n=splice(pipefd[0],NULL,dst,&b,1,0);
+  if(variant==2)CHECK(n==-1&&(errno==EBADF||errno==EACCES));else CHECK(n==1);
+ }
+ CHECK(pread(dst,&c,1,0)==1&&c=='d');return 0;
+}
+static int mappings(void)
+{
+ int fd;void*p,*cow;CHECK(!setup());fd=open(path,O_RDWR);CHECK(fd>=0&&!ftruncate(fd,4096));
+ CHECK(!capop(fd,F_RESTRICTFD_CAP,1));
+ errno=0;CHECK(mmap(NULL,4096,PROT_READ|PROT_WRITE,MAP_SHARED,fd,0)==MAP_FAILED&&errno==EACCES);
+ p=mmap(NULL,4096,PROT_READ,MAP_SHARED,fd,0);CHECK(p!=MAP_FAILED);
+ errno=0;CHECK(mprotect(p,4096,PROT_READ|PROT_WRITE)==-1&&errno==EACCES);
+ cow=mmap(NULL,4096,PROT_READ|PROT_WRITE,MAP_PRIVATE,fd,0);CHECK(cow!=MAP_FAILED);memcpy(cow,"cow!",4);
+ errno=0;CHECK(fallocate(fd,0,0,8192)==-1&&(errno==EBADF||errno==EACCES));
+ return 0;
+}
+static int metadata(void)
+{
+ int fd;char c;CHECK(!setup());fd=open(path,O_RDWR);CHECK(fd>=0&&!capop(fd,F_RESTRICTFD_CAP,0));
+ CHECK(!fchmod(fd,0644));CHECK(!fcntl(fd,F_SETFL,O_APPEND));
+ errno=0;CHECK(read(fd,&c,1)==-1&&errno==EBADF);
+ errno=0;CHECK(write(fd,"x",1)==-1&&errno==EBADF);return 0;
+}
+int main(void)
+{
+ const struct{const char*name;int(*run)(void);int v,need;}cases[]={
+ {"native supplementary-group DAC",groups,0,0},{"UNHANDLED supplementary-group DAC",groups,1,1},
+ {"native non-owner FSUID DAC denial",fsidentity,0,0},
+ {"UNHANDLED additive READ grant with non-owner FSUID",fsidentity,1,1},
+ {"handled READ grant with non-owner FSUID",fsidentity,2,1},{"root DAC cannot exceed handled ceiling",owner_ceiling,0,1},
+ {"READ-only source permits sendfile copy_file_range splice",transfer,0,1},
+ {"zero-read source denies all transfer APIs",transfer,1,1},{"WRITE-less destination denies all transfer APIs",transfer,2,1},
+ {"shared mmap mprotect fallocate attenuation; private COW",mappings,0,1},{"metadata and F_SETFL do not restore data authority",metadata,0,1}};
+ int rc,status;pid_t pid;setvbuf(stdout,NULL,_IONBF,0);ksft_print_header();if(geteuid())ksft_exit_skip("requires root disposable guest\n");
+ errno=0;rc=prctl(PR_CAPAUTH,PR_CAPAUTH_GET_CONFINED,0UL,0UL,0UL);if(rc==-1&&errno!=EINVAL)ksft_exit_fail_msg("query error\n");if(rc>0)ksft_exit_fail_msg("already confined\n");api=rc==0;
+ ksft_set_plan(ARRAY_SIZE(cases));for(unsigned i=0;i<ARRAY_SIZE(cases);i++){
+  if(cases[i].need&&!api){ksft_test_result_skip("%s (API unavailable)\n",cases[i].name);continue;}
+  variant=cases[i].v;pid=fork();CHECK(pid>=0);if(!pid)_exit(cases[i].run());CHECK(waitpid(pid,&status,0)==pid);
+  ksft_test_result(WIFEXITED(status)&&!WEXITSTATUS(status),"%s\n",cases[i].name);
+ }ksft_finished();
+}
