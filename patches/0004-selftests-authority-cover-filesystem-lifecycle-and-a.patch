+static int acl_ceiling(void)
+{
+	/* Linux ACL xattr: version 2, USER_OBJ rw, GROUP_OBJ rw, OTHER rw. */
+	const unsigned char acl[] = {
+		2, 0, 0, 0,
+		1, 0, 6, 0, 255, 255, 255, 255,
+		4, 0, 6, 0, 255, 255, 255, 255,
+		32, 0, 6, 0, 255, 255, 255, 255,
+	};
+
+	if (fsetxattr(datafd, "system.posix_acl_access", acl, sizeof(acl), 0)) {
+		if (errno == EOPNOTSUPP)
+			return KSFT_SKIP;
+		CHECK(0);
+	}
+	CHECK(!fchmodat(rootfd, "in", 0711, 0));
+	CHECK(!confine((1U << READ_SCOPE) | (1U << WRITE_SCOPE)));
+	CHECK(setfsuid(65534) == 0);
+	DENIED(openat(inside, "file", O_RDWR), EACCES);
+	return 0;
+}
