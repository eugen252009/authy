+}
+static int opath(void)
+{
+ int fd;char proc[80];CHECK(!setup()&&!confine());fd=open(path,O_PATH);CHECK(fd>=0);
+ snprintf(proc,sizeof(proc),"/proc/self/fd/%d",fd);errno=0;CHECK(open(proc,O_RDONLY)==-1&&errno==EACCES);return 0;
+}
+static int notification(void)
+{
+ int fan,pipes[2],fd,status;pid_t child;char c;union{uint64_t a;char b[4096];}buf;
