index 0000000000000000000000000000000000000000..2407fff15679cfc345009bb7416d7a2473590427
--- /dev/null
+++ b/tools/testing/selftests/authority/handle_test.c
@@ -0,0 +1,67 @@
+// SPDX-License-Identifier: GPL-2.0
+#define _GNU_SOURCE
+#include <errno.h>
+#include <fcntl.h>
+#include <linux/prctl.h>
+#include <stdint.h>
+#include <stdio.h>
+#include <string.h>
+#include <stdlib.h>
+#include <sys/ioctl.h>
+#include <sys/prctl.h>
+#include <sys/stat.h>
+#include <sys/statfs.h>
+#include <sys/wait.h>
+#include <unistd.h>
+#include "../kselftest.h"
+#define CHECK(c) do{if(!(c)){dprintf(2,"# %s:%d %s errno=%d\n",__func__,__LINE__,#c,errno);return 1;}}while(0)
+/* Exact native xfs_fsop_handlereq layout, without kernel-private types. */
+struct request {uint32_t fd;void *path;uint32_t oflags;void *ihandle;uint32_t ihandlen;void *ohandle;uint32_t *ohandlen;};
+#define PATH_HANDLE _IOWR('X',105,struct request)
+#define OPEN_HANDLE _IOWR('X',107,struct request)
+static int api,rootfd;static char path[180],directory[]="/mnt/xfs/authority-handle.XXXXXX";
+static int confined(int right,int grant)
+{
+ if(grant)CHECK(!prctl(PR_CAPAUTH,PR_CAPAUTH_ADD_FS_SCOPE,(unsigned long)rootfd,(unsigned long)right,0UL));
+ union{uint64_t a;unsigned char b[sizeof(struct pr_capauth_confine)+1];}s={};
+ struct pr_capauth_confine*r=(void*)s.b;r->size=sizeof(s.b);r->version=PR_CAPAUTH_CONFINE_VERSION_1;r->handled[0]=0x18;
+ return prctl(PR_CAPAUTH,PR_CAPAUTH_CONFINE,(unsigned long)r,0UL,0UL);
+}
+static int run(int use_ioctl,int write_mode,int policy,int grant)
+{
+ int fd,mount_id=0;char c=0;struct stat st;
+ union{uint64_t a;unsigned char b[sizeof(struct file_handle)+128];}fh={};
+ struct file_handle*h=(void*)fh.b;h->handle_bytes=128;
+ unsigned char xhandle[128];uint32_t xlen=sizeof(xhandle);
+ struct request req={.path=path,.ohandle=xhandle,.ohandlen=&xlen};
+ if(use_ioctl)CHECK(!ioctl(rootfd,PATH_HANDLE,&req));else CHECK(!name_to_handle_at(AT_FDCWD,path,h,&mount_id,0));
+ if(policy)CHECK(!confined(write_mode?PR_CAPAUTH_FS_WRITE_FILE:PR_CAPAUTH_FS_READ_FILE,grant));
+ errno=0;
+ if(use_ioctl){req.ihandle=xhandle;req.ihandlen=xlen;req.oflags=write_mode?O_WRONLY:O_RDONLY;fd=ioctl(rootfd,OPEN_HANDLE,&req);}
+ else fd=open_by_handle_at(rootfd,h,write_mode?O_WRONLY:O_RDONLY);
+ printf("# %s %s policy=%d grant=%d result=%d errno=%d\n",use_ioctl?"xfs-ioctl":"generic",write_mode?"WRITE":"READ",policy,grant,fd,fd<0?errno:0);
+ if(policy&&!grant){CHECK(fd==-1&&errno==EACCES);CHECK(!stat(path,&st)&&st.st_size==4);return 0;}
+ CHECK(fd>=0);if(write_mode)CHECK(pwrite(fd,"d",1,0)==1);else CHECK(pread(fd,&c,1,0)==1&&c=='d');
+ return 0;
+}
+int main(void)
+{
+ int rc,fd,status;pid_t child;
+ setvbuf(stdout,NULL,_IONBF,0);ksft_print_header();if(geteuid())ksft_exit_skip("requires root disposable XFS guest\n");
+ struct statfs fs;
+ if(statfs("/mnt/xfs",&fs)||fs.f_type!=0x58465342)
+  ksft_exit_skip("requires dedicated disposable XFS fixture at /mnt/xfs\n");
+ CHECK(mkdtemp(directory));snprintf(path,sizeof(path),"%s/fixture",directory);
+ rootfd=open(directory,O_RDONLY|O_DIRECTORY);CHECK(rootfd>=0);
+ fd=open(path,O_CREAT|O_RDWR|O_TRUNC,0600);CHECK(fd>=0&&write(fd,"data",4)==4);close(fd);
+ errno=0;rc=prctl(PR_CAPAUTH,PR_CAPAUTH_GET_CONFINED,0UL,0UL,0UL);
+ if(rc==-1&&errno!=EINVAL)ksft_exit_fail_msg("Authority query error\n");
+ if(rc>0)ksft_exit_fail_msg("already confined\n");
+ api=rc==0;
+ ksft_set_plan(12);
+ for(int ioctl_mode=0;ioctl_mode<2;ioctl_mode++)for(int w=0;w<2;w++)for(int state=0;state<3;state++){
+  if(state&&!api){ksft_test_result_skip("%s %s %s (API unavailable)\n",ioctl_mode?"XFS ioctl":"generic",w?"WRITE":"READ",state==1?"denied":"granted");continue;}
+  child=fork();CHECK(child>=0);if(!child)_exit(run(ioctl_mode,w,state!=0,state==2));
+  CHECK(waitpid(child,&status,0)==child);ksft_test_result(WIFEXITED(status)&&!WEXITSTATUS(status),"%s %s %s\n",ioctl_mode?"XFS ioctl":"generic",w?"WRITE":"READ",state==0?"native":state==1?"denied":"granted");
+ }CHECK(!unlink(path));close(rootfd);CHECK(!rmdir(directory));ksft_finished();
+}
diff --git a/tools/testing/selftests/authority/idmapped_test.c b/tools/testing/selftests/authority/idmapped_test.c
new file mode 100644
index 0000000000000000000000000000000000000000..409bbd4c33049eea6f06b82f5965741d8388fa66
--- /dev/null
+++ b/tools/testing/selftests/authority/idmapped_test.c
@@ -0,0 +1,205 @@
+// SPDX-License-Identifier: GPL-2.0
+#define _GNU_SOURCE
+#include <errno.h>
+#include <fcntl.h>
+#define _ASM_GENERIC_FCNTL_H
+#define F_LINUX_SPECIFIC_BASE 1024
+#include <linux/fcntl.h>
+#include <linux/mount.h>
+#include <linux/prctl.h>
+#include <linux/posix_acl_xattr.h>
+#include <sched.h>
+#include <signal.h>
+#include <stdint.h>
+#include <stdio.h>
+#include <stdlib.h>
+#include <string.h>
+#include <sys/mount.h>
+#include <sys/prctl.h>
+#include <sys/stat.h>
+#include <sys/syscall.h>
+#include <sys/wait.h>
+#include <sys/xattr.h>
+#include <unistd.h>
+#include "../kselftest.h"
+#define CHECK(c) do { if (!(c)) { dprintf(2,"# %s:%d %s errno=%d\n",__func__,__LINE__,#c,errno); return 1; } } while (0)
+static int api, managed, plain, mapped, dfd, ofd;
+static char base[128], ppath[160], mpath[160];
+static int capop(int fd,int op,unsigned char bits)
+{
+ union {uint64_t align;unsigned char bytes[sizeof(struct fd_cap_request)+1];} s={};
+ struct fd_cap_request *r=(void *)s.bytes;
+ r->size=sizeof(s.bytes);r->version=FD_CAP_VERSION_1;r->rights[0]=bits;
+ int rc=fcntl(fd,op,r);
+ return !rc&&op==F_GETFD_CAP?r->rights[0]:rc;
+}
+static int confine(unsigned char mask)
+{
+ if(!managed)return 0;
+ union {uint64_t align;unsigned char bytes[sizeof(struct pr_capauth_confine)+1];} s={};
+ struct pr_capauth_confine *r=(void *)s.bytes;
+ r->size=sizeof(s.bytes);r->version=PR_CAPAUTH_CONFINE_VERSION_1;r->handled[0]=mask;
+ return prctl(PR_CAPAUTH,PR_CAPAUTH_CONFINE,(unsigned long)r,0UL,0UL);
+}
+static int scope(int fd,int right)
+{
+ return managed?prctl(PR_CAPAUTH,PR_CAPAUTH_ADD_FS_SCOPE,(unsigned long)fd,(unsigned long)right,0UL):0;
+}
+static int text(const char *path,const char *value)
+{
+ int fd=open(path,O_WRONLY);if(fd<0)return -1;
+ ssize_t n=write(fd,value,strlen(value));close(fd);return n==(ssize_t)strlen(value)?0:-1;
+}
+static int userns(void)
+{
+ int ready[2],hold[2],ns,status;pid_t pid;char path[100],c;
+ if(pipe(ready)||pipe(hold))return -1;
+ pid=fork();if(pid<0)return -1;
+ if(!pid){close(ready[0]);close(hold[1]);if(unshare(CLONE_NEWUSER))_exit(1);if(write(ready[1],"r",1)!=1)_exit(1);read(hold[0],&c,1);_exit(0);}
+ close(ready[1]);close(hold[0]);
+ if(read(ready[0],&c,1)!=1){waitpid(pid,&status,0);return -1;}
+ snprintf(path,sizeof(path),"/proc/%d/setgroups",pid);if(text(path,"deny\n"))goto fail;
+ snprintf(path,sizeof(path),"/proc/%d/uid_map",pid);if(text(path,"0 1000 1\n"))goto fail;
+ snprintf(path,sizeof(path),"/proc/%d/gid_map",pid);if(text(path,"0 1000 1\n"))goto fail;
+ snprintf(path,sizeof(path),"/proc/%d/ns/user",pid);ns=open(path,O_RDONLY|O_CLOEXEC);
+ close(hold[1]);close(ready[0]);waitpid(pid,&status,0);return ns;
+fail:
+ close(hold[1]);close(ready[0]);waitpid(pid,&status,0);return -1;
+}
+static int setup(void)
+{
+ int ns,tree,fd;struct mount_attr attr={};
+ CHECK(!unshare(CLONE_NEWNS));CHECK(!mount(NULL,"/",NULL,MS_REC|MS_PRIVATE,NULL));
+ strcpy(base,"/tmp/authority-map.XXXXXX");CHECK(mkdtemp(base));CHECK(!chmod(base,0755));
+ snprintf(ppath,sizeof(ppath),"%s/plain",base);snprintf(mpath,sizeof(mpath),"%s/mapped",base);
+ CHECK(!mkdir(ppath,0755)&&!mkdir(mpath,0755));CHECK(!mount("tmpfs",ppath,"tmpfs",0,"mode=0755"));
+ plain=open(ppath,O_PATH|O_DIRECTORY);CHECK(plain>=0);
+ CHECK(!mkdirat(plain,"d",0777)&&!mkdirat(plain,"other",0777));
+ CHECK(!fchmodat(plain,"d",0777,0)&&!fchmodat(plain,"other",0777,0));
+ fd=openat(plain,"f",O_CREAT|O_RDWR,0600);CHECK(fd>=0&&write(fd,"data",4)==4);close(fd);
+ CHECK(!mkdirat(plain,"hidden",0700));
+ fd=openat(plain,"hidden/f",O_CREAT|O_RDWR,0600);CHECK(fd>=0);close(fd);
+ CHECK(!fchmodat(plain,"hidden",0000,0));
+ ns=userns();CHECK(ns>=0);
+ tree=syscall(SYS_open_tree,AT_FDCWD,ppath,OPEN_TREE_CLONE|OPEN_TREE_CLOEXEC);CHECK(tree>=0);
+ attr.attr_set=MOUNT_ATTR_IDMAP;attr.userns_fd=ns;
+ CHECK(!syscall(SYS_mount_setattr,tree,"",AT_EMPTY_PATH,&attr,sizeof(attr)));
+ CHECK(!syscall(SYS_move_mount,tree,"",AT_FDCWD,mpath,MOVE_MOUNT_F_EMPTY_PATH));
+ errno=0;int remap=syscall(SYS_mount_setattr,tree,"",AT_EMPTY_PATH,&attr,sizeof(attr));
+ printf("# existing mapped mount re-idmap ret=%d errno=%d\n",remap,errno);
+ CHECK(remap==-1&&(errno==EPERM||errno==EINVAL||errno==EBUSY));close(ns);close(tree);
+ mapped=open(mpath,O_PATH|O_DIRECTORY);CHECK(mapped>=0);
+ dfd=openat(mapped,"d",O_PATH|O_DIRECTORY);ofd=openat(mapped,"other",O_PATH|O_DIRECTORY);CHECK(dfd>=0&&ofd>=0);
+ return 0;
+}
+static int drop(void){return setgid(1000)||setuid(1000);}
+static int identity(void)
+{
+ struct stat a,b;int fd,alias;char c;
+ CHECK(!setup());CHECK(!fstatat(plain,"f",&a,0)&&!fstatat(mapped,"f",&b,0));
+ CHECK(a.st_ino==b.st_ino&&a.st_dev==b.st_dev&&a.st_uid==0&&b.st_uid==1000&&b.st_gid==1000);
+ CHECK(!confine(0)&&!drop());errno=0;CHECK(openat(plain,"f",O_RDONLY)==-1&&errno==EACCES);
+ errno=0;CHECK(openat(mapped,"hidden/f",O_RDONLY)==-1&&errno==EACCES);
+ fd=openat(mapped,"f",O_RDWR);CHECK(fd>=0);alias=dup(fd);CHECK(alias>=0&&pread(alias,&c,1,0)==1&&c=='d');
+ CHECK(!ftruncate(fd,2));CHECK(!fstat(alias,&b)&&b.st_size==2);return 0;
+}
+static int ceiling(void)
+{
+ int fd,clone,alias;char c;
+ CHECK(!setup()&&!scope(plain,PR_CAPAUTH_FS_READ_FILE));
+ CHECK(!fchmodat(plain,"f",0000,0));CHECK(!confine(0x18)&&!drop());
+ errno=0;CHECK(openat(plain,"hidden/f",O_RDONLY)==-1&&errno==EACCES);
+ fd=openat(plain,"f",O_RDONLY);CHECK(fd>=0&&pread(fd,&c,1,0)==1&&c=='d');
+ errno=0;CHECK(openat(mapped,"f",O_RDONLY)==-1&&errno==EACCES);
+ clone=capop(fd,F_CLONEFD_CAP,3);CHECK(clone>=0&&capop(clone,F_GETFD_CAP,0)==1);
+ CHECK(lseek(fd,1,SEEK_SET)==1&&read(clone,&c,1)==1&&c=='d');
+ alias=dup(clone);CHECK(alias>=0&&!capop(clone,F_RESTRICTFD_CAP,0));
+ errno=0;CHECK(read(alias,&c,1)==-1&&errno==EBADF);CHECK(read(fd,&c,1)==1&&c=='a');
+ return 0;
+}
+static int mapped_data(void)
+{
+ int fd,clone;char c;
+ CHECK(!setup()&&!scope(mapped,PR_CAPAUTH_FS_READ_FILE)&&!scope(mapped,PR_CAPAUTH_FS_WRITE_FILE));
+ CHECK(!confine(0x18)&&!drop());fd=openat(mapped,"f",O_RDWR);CHECK(fd>=0);
+ CHECK(!ftruncate(fd,3)&&pwrite(fd,"d",1,0)==1);
+ errno=0;CHECK(openat(plain,"f",O_RDONLY)==-1&&errno==EACCES);
+ clone=capop(fd,F_CLONEFD_CAP,1);CHECK(clone>=0&&capop(clone,F_GETFD_CAP,0)==1&&pread(clone,&c,1,0)==1);
+ errno=0;CHECK(pwrite(clone,"x",1,0)==-1&&errno==EBADF);
+ errno=0;CHECK(ftruncate(clone,0)==-1&&(errno==EBADF||errno==EACCES));return 0;
+}
+static int namespace_ops(void)
+{
+ struct stat st;int fd,otherplain;char buf[4];
+ CHECK(!setup());
+ for(int r=1;r<=7;r++){if(r==2)continue;CHECK(!scope(dfd,r)&&!scope(ofd,r));}
+ otherplain=openat(plain,"d",O_PATH|O_DIRECTORY);CHECK(otherplain>=0);
+ CHECK(!confine(0xfa)&&!drop());
+ fd=openat(dfd,"new",O_CREAT|O_EXCL|O_RDWR,0600);CHECK(fd>=0&&write(fd,"data",4)==4);
+ CHECK(!fstatat(dfd,"new",&st,0)&&st.st_uid==1000&&st.st_gid==1000);
+ CHECK(!fstatat(otherplain,"new",&st,0)&&st.st_uid==0&&st.st_gid==0);
+ CHECK(!linkat(dfd,"new",ofd,"linked",0));
+ errno=0;CHECK(linkat(dfd,"new",otherplain,"cross",0)==-1&&errno==EXDEV);
+ errno=0;CHECK(syscall(SYS_renameat2,dfd,"new",otherplain,"cross",0)==-1&&errno==EXDEV);
+ CHECK(!syscall(SYS_renameat2,dfd,"new",ofd,"moved",RENAME_NOREPLACE));
+ errno=0;CHECK(syscall(SYS_renameat2,ofd,"moved",ofd,"linked",RENAME_NOREPLACE)==-1&&errno==EEXIST);
+ CHECK(!syscall(SYS_renameat2,ofd,"moved",ofd,"linked",RENAME_EXCHANGE));
+ CHECK(!fchmod(fd,0400)&&!ftruncate(fd,2));
+ CHECK(!unlinkat(ofd,"linked",0)&&!unlinkat(ofd,"moved",0));
+ CHECK(pread(fd,buf,2,0)==2&&!memcmp(buf,"da",2));return 0;
+}
+static int acl(void)
+{
+ struct {struct posix_acl_xattr_header h;struct posix_acl_xattr_entry e[5];} a={};
+ int fd;
+ CHECK(!setup());fd=openat(plain,"a",O_CREAT|O_RDWR,0600);CHECK(fd>=0);
+ a.h.a_version=2;
+ unsigned short tags[]={1,2,4,16,32}, perms[]={0,4,0,4,0};
+ for(int i=0;i<5;i++){a.e[i].e_tag=tags[i];a.e[i].e_perm=perms[i];a.e[i].e_id=i==1?1000:0xffffffffU;}
+ CHECK(!fsetxattr(fd,"system.posix_acl_access",&a,sizeof(a),0));close(fd);
+ CHECK(!scope(mapped,PR_CAPAUTH_FS_READ_FILE)&&!confine(0x08)&&!drop());
+ errno=0;fd=openat(plain,"a",O_RDONLY);
+ if(managed){CHECK(fd==-1&&errno==EACCES);fd=openat(mapped,"a",O_RDONLY);CHECK(fd>=0);}
+ else {CHECK(fd>=0);errno=0;CHECK(openat(mapped,"a",O_RDONLY)==-1&&errno==EACCES);}
+ return 0;
+}
+static int nested_userns(void)
+{
+ CHECK(!setup());
+ CHECK(!unshare(CLONE_NEWUSER));
+ errno=0;
+ CHECK(prctl(PR_CAPAUTH,PR_CAPAUTH_ADD_FS_SCOPE,(unsigned long)plain,
+             (unsigned long)PR_CAPAUTH_FS_READ_FILE,0UL)==-1&&errno==EPERM);
+ return 0;
+}
+int main(void)
+{
+ const struct {const char *name;int (*run)(void);int mode;} cases[]={
+ {"native idmap identity DAC traversal dup truncate",identity,0},
+ {"unhandled idmap identity DAC traversal dup truncate",identity,1},
+ {"handled scope cannot cross idmapped alias; clone attenuation",ceiling,1},
+ {"mapped scope DATA ceiling and read-only derivation",mapped_data,1},
+ {"native mapped create ownership link rename unlink lifetime",namespace_ops,0},
+ {"managed mapped create ownership link rename unlink lifetime",namespace_ops,1},
+ {"native ACL identity translation",acl,0},{"handled ACL scope ceiling and generic DAC grant",acl,1},
+ {"nested userns root cannot manufacture initial-userns Authority scopes",nested_userns,1}};
+ int rc,status;pid_t pid;
+ setvbuf(stdout,NULL,_IONBF,0);ksft_print_header();if(geteuid())ksft_exit_skip("requires isolated root guest\n");
+ errno=0;rc=prctl(PR_CAPAUTH,PR_CAPAUTH_GET_CONFINED,0UL,0UL,0UL);
+ if(rc==-1&&errno!=EINVAL)ksft_exit_fail_msg("Authority query error %d\n",errno);
+ if(rc>0)ksft_exit_fail_msg("requires initially unconfined process\n");
+ api=rc==0;
+ /* Namespace setup is a prerequisite, checked before target assertions. */
+ pid=fork();CHECK(pid>=0);
+ if(!pid)_exit((unshare(CLONE_NEWNS)||unshare(CLONE_NEWUSER))?4:0);
+ CHECK(waitpid(pid,&status,0)==pid);
+ if(!WIFEXITED(status)||WEXITSTATUS(status))
+  ksft_exit_skip("user/mount namespace setup unavailable in this environment\n");
+ ksft_set_plan(ARRAY_SIZE(cases));
+ for(unsigned i=0;i<ARRAY_SIZE(cases);i++){
+  if(cases[i].mode&&!api){ksft_test_result_skip("%s (custom API unavailable)\n",cases[i].name);continue;}
+  managed=cases[i].mode;pid=fork();CHECK(pid>=0);if(!pid)_exit(cases[i].run());
+  CHECK(waitpid(pid,&status,0)==pid);ksft_test_result(WIFEXITED(status)&&!WEXITSTATUS(status),"%s\n",cases[i].name);
+ }
+ ksft_finished();
+}
diff --git a/tools/testing/selftests/authority/qualification_test.c b/tools/testing/selftests/authority/qualification_test.c
