+ errno=0;CHECK(open(path,O_RDONLY)==-1&&errno==EACCES);
+ fd=syscall(SYS_pidfd_getfd,pidfd,remote,0);CHECK(fd>=0&&capop(fd,F_GETFD_CAP,0)==variant);
