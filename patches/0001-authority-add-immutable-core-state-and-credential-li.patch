diff --git a/kernel/authority.c b/kernel/authority.c
new file mode 100644
index 0000000000000000000000000000000000000000..6a513c4b2dfaac142d4f2d93c654bad70e8187e0
--- /dev/null
+++ b/kernel/authority.c
@@ -0,0 +1,1047 @@
+// SPDX-License-Identifier: GPL-2.0
+/* Minimal immutable, variable-length authority rights and object scopes. */
+#include <linux/authority.h>
+#include <linux/bitmap.h>
+#include <linux/cred.h>
+#include <linux/dcache.h>
+#include <linux/errno.h>
+#include <linux/export.h>
+#include <linux/fs.h>
+#include <linux/kernel.h>
+#ifdef CONFIG_KUNIT
+#include <kunit/test.h>
+#endif
+#include <linux/overflow.h>
+#include <linux/path.h>
+#include <linux/refcount.h>
+#include <linux/slab.h>
+#include <linux/workqueue.h>
+
+struct authority_scope {
+	struct path root;
+	u32 nbits;
+	unsigned long *rights;
+};
+
+struct authority_class {
+	u32 id;
+	u32 nbits;
+	unsigned long *bits;
+	bool sealed;
+	u32 handled_nbits;
+	unsigned long *handled;
+	u32 nscopes;
+	struct authority_scope *scopes;
+};
+
+struct authority {
+	refcount_t refs;
+	struct work_struct free_work;
+	bool confined;
+	u32 nr_classes;
+	struct authority_class classes[];
+};
+
+struct authority_class_ops {
+	u32 class_id;
+	bool (*operation_implemented)(u32 operation);
+	int (*evaluate)(const struct authority *authority,
+			const struct authority_request *request);
+	int (*clone_state)(struct authority_class *dst,
+			   const struct authority_class *src, gfp_t gfp);
+	void (*destroy_state)(struct authority_class *class);
+};
+
+static bool authority_right_supported(u32 class_id, u32 right)
+{
+	return class_id == AUTH_CLASS_FILESYSTEM &&
+		(right == AUTH_FS_DAC_OVERRIDE ||
+		 right == AUTH_FS_CREATE_FILE ||
+		 right == AUTH_FS_TRAVERSE ||
+		 right == AUTH_FS_READ_FILE ||
+		 right == AUTH_FS_WRITE_FILE ||
+		 right == AUTH_FS_DELETE_FILE ||
+		 right == AUTH_FS_RENAME ||
+		 right == AUTH_FS_LINK ||
+		 right == AUTH_FS_TEST_RIGHT_80);
+}
+
+static const struct authority_class *authority_find_class(
+		const struct authority *authority, u32 class_id)
+{
+	u32 i;
+
+	if (!authority)
+		return NULL;
+
+	for (i = 0; i < authority->nr_classes; i++)
+		if (authority->classes[i].id == class_id)
+			return &authority->classes[i];
+	return NULL;
+}
+
+static struct authority_class *authority_find_class_mut(
+		struct authority *authority, u32 class_id)
+{
+	u32 i;
+
+	for (i = 0; i < authority->nr_classes; i++)
+		if (authority->classes[i].id == class_id)
+			return &authority->classes[i];
+	return NULL;
+}
+
+static int authority_fs_clone_state(struct authority_class *dst,
+				    const struct authority_class *src,
+				    gfp_t gfp);
+static void authority_fs_destroy_state(struct authority_class *class);
+#ifdef CONFIG_KUNIT
+static bool authority_test_operation_implemented(u32 operation);
+static int authority_test_evaluate(const struct authority *authority,
+				   const struct authority_request *request);
+#endif
+
+#ifdef CONFIG_KUNIT
+static const struct authority_class_ops authority_test_class_ops = {
+	.class_id = 0x7fff0001,
+	.operation_implemented = authority_test_operation_implemented,
+	.evaluate = authority_test_evaluate,
+};
+#endif
+
+static bool authority_fs_operation_implemented(u32 operation)
+{
+	switch (operation) {
+	case AUTH_FS_OP_CREATE_FILE:
+	case AUTH_FS_OP_TRAVERSE:
+	case AUTH_FS_OP_READ_FILE:
+	case AUTH_FS_OP_WRITE_FILE:
+	case AUTH_FS_OP_DELETE_FILE:
+	case AUTH_FS_OP_RENAME:
+	case AUTH_FS_OP_LINK:
+		return true;
+	default:
+		return false;
+	}
+}
+
+static int authority_fs_evaluate(const struct authority *authority,
+				const struct authority_request *request)
+{
+	bool allowed = false;
+	int error;
+
+	if (!request->context.filesystem.path)
+		return -EACCES;
+	error = authority_has_scoped_right(authority,
+					   request->context.filesystem.path,
+					   AUTH_CLASS_FILESYSTEM,
+					   request->operation, &allowed);
+	if (error)
+		return error;
+	return allowed ? 0 : -EACCES;
+}
+
+static struct authority_class_ops authority_fs_class_ops = {
+	.class_id = AUTH_CLASS_FILESYSTEM,
+	.operation_implemented = authority_fs_operation_implemented,
+	.evaluate = authority_fs_evaluate,
+	.clone_state = authority_fs_clone_state,
+	.destroy_state = authority_fs_destroy_state,
+};
+
+static const struct authority_class_ops *authority_find_class_ops(u32 class_id)
+{
+	switch (class_id) {
+	case AUTH_CLASS_FILESYSTEM:
+		return &authority_fs_class_ops;
+#ifdef CONFIG_KUNIT
+	case 0x7fff0001:
+		return &authority_test_class_ops;
+#endif
+	default:
+		return NULL;
+	}
+}
+
+static void authority_free_work(struct work_struct *work);
+
+static struct authority *authority_alloc(u32 nr_classes, gfp_t gfp)
+{
+	struct authority *authority;
+	size_t size;
+
+	if (check_mul_overflow((size_t)nr_classes,
+			       sizeof(struct authority_class), &size) ||
+	    check_add_overflow(sizeof(*authority), size, &size))
+		return NULL;
+
+	authority = kzalloc(size, gfp);
+	if (!authority)
+		return NULL;
+
+	refcount_set(&authority->refs, 1);
+	INIT_WORK(&authority->free_work, authority_free_work);
+	authority->nr_classes = nr_classes;
+	return authority;
+}
+
+static void authority_fs_destroy_state(struct authority_class *class)
+{
+	u32 i;
+
+	for (i = 0; i < class->nscopes; i++) {
+		path_put(&class->scopes[i].root);
+		bitmap_free(class->scopes[i].rights);
+	}
+	kfree(class->scopes);
+	class->scopes = NULL;
+	class->nscopes = 0;
+}
+
+static int authority_fs_clone_state(struct authority_class *dst,
+				    const struct authority_class *src,
+				    gfp_t gfp)
+{
+	u32 i;
+
+	if (!src->nscopes)
+		return 0;
+	dst->scopes = kcalloc(src->nscopes, sizeof(*dst->scopes), gfp);
+	if (!dst->scopes)
+		return -ENOMEM;
+	for (i = 0; i < src->nscopes; i++) {
+		struct authority_scope *to = &dst->scopes[i];
+		const struct authority_scope *from = &src->scopes[i];
+
+		to->root = from->root;
+		path_get(&to->root);
+		to->nbits = from->nbits;
+		to->rights = bitmap_alloc(to->nbits, gfp);
+		if (!to->rights) {
+			path_put(&to->root);
+			return -ENOMEM;
+		}
+		bitmap_copy(to->rights, from->rights, to->nbits);
+		dst->nscopes++;
+	}
+	return 0;
+}
+
+static void authority_destroy(struct authority *authority)
+{
+	u32 i;
+
+	for (i = 0; i < authority->nr_classes; i++) {
+		struct authority_class *class = &authority->classes[i];
+		const struct authority_class_ops *ops =
+			authority_find_class_ops(class->id);
+
+		if (ops && ops->destroy_state)
+			ops->destroy_state(class);
+		bitmap_free(class->bits);
+		bitmap_free(class->handled);
+	}
+	kfree(authority);
+}
+
+static int authority_copy_class(struct authority_class *dst,
+				const struct authority_class *src,
+				gfp_t gfp)
+{
+	const struct authority_class_ops *ops;
+
+	dst->id = src->id;
+	dst->nbits = src->nbits;
+	dst->sealed = src->sealed;
+	dst->handled_nbits = src->handled_nbits;
+	if (src->nbits) {
+		dst->bits = bitmap_alloc(src->nbits, gfp);
+		if (!dst->bits)
+			return -ENOMEM;
+		bitmap_copy(dst->bits, src->bits, src->nbits);
+	}
+	if (src->handled_nbits) {
+		dst->handled = bitmap_alloc(src->handled_nbits, gfp);
+		if (!dst->handled)
+			return -ENOMEM;
+		bitmap_copy(dst->handled, src->handled, src->handled_nbits);
+	}
+	ops = authority_find_class_ops(src->id);
+	if (ops && ops->clone_state)
+		return ops->clone_state(dst, src, gfp);
+	return 0;
+}
+
+static struct authority *authority_clone(const struct authority *old,
+					 u32 nr_classes, gfp_t gfp)
+{
+	struct authority *copy;
+	u32 i;
+
+	copy = authority_alloc(nr_classes, gfp);
+	if (!copy)
+		return NULL;
+
+	if (!old)
+		return copy;
+
+	copy->confined = old->confined;
+	for (i = 0; i < old->nr_classes; i++) {
+		if (authority_copy_class(&copy->classes[i], &old->classes[i], gfp)) {
+			authority_destroy(copy);
+			return NULL;
+		}
+	}
+	return copy;
+}
+
+struct authority *authority_create_fs_poc(gfp_t gfp)
+{
+	struct authority *authority;
+	struct authority_class *class;
+
+	authority = authority_alloc(1, gfp);
+	if (!authority)
+		return NULL;
+
+	class = &authority->classes[0];
+	class->id = AUTH_CLASS_FILESYSTEM;
+	class->nbits = AUTH_FS_TEST_RIGHT_80 + 1;
+	class->bits = bitmap_zalloc(class->nbits, gfp);
+	if (!class->bits) {
+		authority_destroy(authority);
+		return NULL;
+	}
+
+	/* Legacy AUTH_SYSTEM stays an explicit global regression grant. */
+	__set_bit(AUTH_FS_DAC_OVERRIDE, class->bits);
+	__set_bit(AUTH_FS_TEST_RIGHT_80, class->bits);
+	return authority;
+}
+
+int authority_enter_confined(const struct authority *old,
+			     const unsigned long *handled,
+			     u32 handled_nbits,
+			     struct authority **new)
+{
+	const struct authority_class *class;
+	struct authority_class *fs_class;
+	struct authority *copy;
+	u32 nr_classes;
+
+	if (!new || !handled || handled_nbits != AUTH_FS_TEST_RIGHT_80 + 1)
+		return -EINVAL;
+	*new = NULL;
+	if (old && old->confined)
+		return -EALREADY;
+	class = authority_find_class(old, AUTH_CLASS_FILESYSTEM);
+	if (class && test_bit(AUTH_FS_DAC_OVERRIDE, class->bits))
+		return -EPERM;
+
+	nr_classes = old ? old->nr_classes : 0;
+	if (!class && check_add_overflow(nr_classes, 1U, &nr_classes))
+		return -EOVERFLOW;
+	copy = authority_clone(old, nr_classes, GFP_KERNEL);
+	if (!copy)
+		return -ENOMEM;
+	fs_class = authority_find_class_mut(copy, AUTH_CLASS_FILESYSTEM);
+	if (!fs_class) {
+		fs_class = &copy->classes[copy->nr_classes - 1];
+		fs_class->id = AUTH_CLASS_FILESYSTEM;
+		fs_class->nbits = AUTH_FS_TEST_RIGHT_80 + 1;
+		fs_class->bits = bitmap_zalloc(fs_class->nbits, GFP_KERNEL);
+		if (!fs_class->bits) {
+			authority_put(copy);
+			return -ENOMEM;
+		}
+	}
+	bitmap_free(fs_class->handled);
+	fs_class->handled = bitmap_alloc(handled_nbits, GFP_KERNEL);
+	if (!fs_class->handled) {
+		authority_put(copy);
+		return -ENOMEM;
+	}
+	bitmap_copy(fs_class->handled, handled, handled_nbits);
+	fs_class->handled_nbits = handled_nbits;
+	copy->confined = true;
+	*new = copy;
+	return 0;
+}
+
+bool authority_is_confined(const struct cred *cred)
+{
+	return cred && cred->authority && cred->authority->confined;
+}
+
+static enum authority_operation_state authority_operation_state(
+		const struct authority *authority, u32 class_id, u32 operation)
+{
+	const struct authority_class *class;
+	const struct authority_class_ops *ops;
+
+	if (!authority || !authority->confined)
+		return AUTHORITY_UNHANDLED;
+	class = authority_find_class(authority, class_id);
+	if (!class)
+		return AUTHORITY_UNHANDLED;
+	if (!class->sealed &&
+	    (!class->handled || operation >= class->handled_nbits ||
+	     !test_bit(operation, class->handled)))
+		return AUTHORITY_UNHANDLED;
+	ops = authority_find_class_ops(class_id);
+	if (!ops || !ops->operation_implemented || !ops->evaluate ||
+	    !ops->operation_implemented(operation))
+		return AUTHORITY_HANDLED_UNIMPLEMENTED;
+	return AUTHORITY_HANDLED_IMPLEMENTED;
+}
+
+int authority_request_check(const struct cred *cred,
+			    const struct authority_request *request,
+			    enum authority_operation_state *state)
+{
+	const struct authority_class_ops *ops;
+
+	if (!request || !state)
+		return -EINVAL;
+	*state = authority_operation_state(cred ? cred->authority : NULL,
+					  request->class_id,
+					  request->operation);
+	switch (*state) {
+	case AUTHORITY_UNHANDLED:
+		/* The caller retains the legacy Linux decision path. */
+		return 0;
+	case AUTHORITY_HANDLED_UNIMPLEMENTED:
+		return -EOPNOTSUPP;
+	case AUTHORITY_HANDLED_IMPLEMENTED:
+		ops = authority_find_class_ops(request->class_id);
+		return ops->evaluate(cred->authority, request);
+	}
+	return -EOPNOTSUPP;
+}
+EXPORT_SYMBOL_GPL(authority_request_check);
+
+int authority_fs_operation_check(const struct cred *cred,
+				const struct path *path,
+				enum authority_fs_operation operation)
+{
+	struct authority_request request = {
+		.class_id = AUTH_CLASS_FILESYSTEM,
+		.operation = operation,
+		.context.filesystem.path = path,
+	};
+	enum authority_operation_state state;
+
+	return authority_request_check(cred, &request, &state);
+}
+
+bool authority_fs_right_handled(const struct cred *cred,
+				enum authority_fs_right right)
+{
+	return authority_operation_state(cred ? cred->authority : NULL,
+					 AUTH_CLASS_FILESYSTEM, right) !=
+		AUTHORITY_UNHANDLED;
+}
+
+bool authority_fs_access_handled(const struct cred *cred, u32 access)
+{
+	return ((access & AUTH_FS_ACCESS_READ) &&
+		authority_fs_right_handled(cred, AUTH_FS_READ_FILE)) ||
+	       ((access & AUTH_FS_ACCESS_WRITE) &&
+		authority_fs_right_handled(cred, AUTH_FS_WRITE_FILE));
+}
+
+/* Shared semantic ceiling for exceptional fresh-open VFS entry points. */
+int authority_fs_access_ceiling_check(const struct cred *cred,
+				      const struct path *path, u32 access)
+{
+	int error;
+
+	if (!access || access & ~(AUTH_FS_ACCESS_READ | AUTH_FS_ACCESS_WRITE))
+		return -EINVAL;
+	if (access & AUTH_FS_ACCESS_READ) {
+		error = authority_fs_operation_check(cred, path,
+						    AUTH_FS_OP_READ_FILE);
+		if (error)
+			return error;
+	}
+	if (access & AUTH_FS_ACCESS_WRITE)
+		return authority_fs_operation_check(cred, path,
+						   AUTH_FS_OP_WRITE_FILE);
+	return 0;
+}
+EXPORT_SYMBOL_GPL(authority_fs_access_ceiling_check);
+
+static void authority_free_work(struct work_struct *work)
+{
+	struct authority *authority = container_of(work, struct authority,
+						   free_work);
+
+	authority_destroy(authority);
+}
+
+struct authority *authority_get(struct authority *authority)
+{
+	if (authority)
+		refcount_inc(&authority->refs);
+	return authority;
+}
+
+void authority_put(struct authority *authority)
+{
+	if (authority && refcount_dec_and_test(&authority->refs))
+		/* cred destruction may call us from an RCU callback. */
+		schedule_work(&authority->free_work);
+}
+
+void authority_cred_replace(struct cred *cred, struct authority *authority)
+{
+	struct authority *old = cred->authority;
+
+	cred->authority = authority;
+	authority_put(old);
+}
+
+void authority_cred_clear(struct cred *cred)
+{
+	/* Privileged exec must never erase an irreversible domain. */
+	if (cred->authority && cred->authority->confined)
+		return;
+	authority_cred_replace(cred, NULL);
+}
+
+int authority_has_right(const struct authority *authority, u32 class_id,
+			u32 right, bool *has_right)
+{
+	const struct authority_class *class;
+
+	if (!has_right || !authority_right_supported(class_id, right))
+		return -EINVAL;
+
+	*has_right = false;
+	class = authority_find_class(authority, class_id);
+	if (class && right < class->nbits)
+		*has_right = test_bit(right, class->bits);
+	return 0;
+}
+
+static bool authority_path_in_scope(const struct authority_scope *scope,
+				    const struct path *path)
+{
+	/* Scope identity is mount-specific and follows dentry rename operations. */
+	return path->mnt == scope->root.mnt &&
+		is_subdir(path->dentry, scope->root.dentry);
+}
+
+int authority_has_scoped_right(const struct authority *authority,
+			       const struct path *path, u32 class_id,
+			       u32 right, bool *has_right)
+{
+	const struct authority_class *class;
+	u32 i;
+
+	if (!path || !path->mnt || !path->dentry || !has_right ||
+	    !authority_right_supported(class_id, right))
+		return -EINVAL;
+
+	*has_right = false;
+	class = authority_find_class(authority, class_id);
+	if (!class)
+		return 0;
+
+	for (i = 0; i < class->nscopes; i++) {
+		const struct authority_scope *scope = &class->scopes[i];
+
+		if (right < scope->nbits && test_bit(right, scope->rights) &&
+		    ((right == AUTH_FS_DELETE_FILE ||
+		      right == AUTH_FS_RENAME ||
+		      right == AUTH_FS_LINK) ?
+		     (scope->root.mnt == path->mnt &&
+		      scope->root.dentry == path->dentry) :
+		     authority_path_in_scope(scope, path))) {
+			*has_right = true;
+			break;
+		}
+	}
+	return 0;
+}
+
+bool authority_allows_fs(const struct cred *cred, const struct path *path,
+			 enum authority_fs_right right)
+{
+	bool allowed;
+
+	return cred &&
+		!authority_has_scoped_right(cred->authority, path,
+					    AUTH_CLASS_FILESYSTEM, right,
+					    &allowed) && allowed;
+}
+
+bool authority_allows_fs_exact(const struct cred *cred,
+			       const struct path *path,
+			       enum authority_fs_right right)
+{
+	const struct authority_class *class;
+	u32 i;
+
+	if (!cred || !path || !path->mnt || !path->dentry ||
+	    !authority_right_supported(AUTH_CLASS_FILESYSTEM, right))
+		return false;
+
+	class = authority_find_class(cred->authority, AUTH_CLASS_FILESYSTEM);
+	if (!class)
+		return false;
+
+	for (i = 0; i < class->nscopes; i++) {
+		const struct authority_scope *scope = &class->scopes[i];
+
+		if (scope->root.mnt == path->mnt &&
+		    scope->root.dentry == path->dentry &&
+		    right < scope->nbits && test_bit(right, scope->rights))
+			return true;
+	}
+	return false;
+}
+
+bool authority_allows_fs_access(const struct cred *cred,
+				const struct path *path, u32 access)
+{
+	if (!access || access & ~(AUTH_FS_ACCESS_READ | AUTH_FS_ACCESS_WRITE))
+		return false;
+	if ((access & AUTH_FS_ACCESS_READ) &&
+	    !authority_allows_fs(cred, path, AUTH_FS_READ_FILE))
+		return false;
+	if ((access & AUTH_FS_ACCESS_WRITE) &&
+	    !authority_allows_fs(cred, path, AUTH_FS_WRITE_FILE))
+		return false;
+	return true;
+}
+
+static bool authority_same_path(const struct path *a, const struct path *b)
+{
+	return a->mnt == b->mnt && a->dentry == b->dentry;
+}
+
+int authority_add_fs_scope(const struct authority *old,
+			   const struct path *root, u32 right,
+			   struct authority **new)
+{
+	struct authority *copy;
+	struct authority_class *class;
+	struct authority_scope *scopes, *scope;
+	const struct authority_class *old_class;
+	u32 i, nr_classes, nr_scopes;
+
+	if (!new || !root || !root->mnt || !root->dentry ||
+	    !d_inode(root->dentry) ||
+	    !S_ISDIR(d_inode(root->dentry)->i_mode) ||
+	    !authority_right_supported(AUTH_CLASS_FILESYSTEM, right))
+		return -EINVAL;
+	*new = NULL;
+	if (old && old->confined)
+		return -EPERM;
+
+	old_class = authority_find_class(old, AUTH_CLASS_FILESYSTEM);
+	if (old_class) {
+		for (i = 0; i < old_class->nscopes; i++) {
+			if (!authority_same_path(root, &old_class->scopes[i].root))
+				continue;
+			if (test_bit(right, old_class->scopes[i].rights))
+				return -EEXIST;
+			copy = authority_clone(old, old->nr_classes, GFP_KERNEL);
+			if (!copy)
+				return -ENOMEM;
+			class = authority_find_class_mut(copy,
+							AUTH_CLASS_FILESYSTEM);
+			__set_bit(right, class->scopes[i].rights);
+			*new = copy;
+			return 0;
+		}
+	}
+	nr_classes = old ? old->nr_classes : 1;
+	if (!old_class && old) {
+		if (check_add_overflow(nr_classes, 1U, &nr_classes))
+			return -EOVERFLOW;
+	}
+	copy = authority_clone(old, nr_classes, GFP_KERNEL);
+	if (!copy)
+		return -ENOMEM;
+
+	class = authority_find_class_mut(copy, AUTH_CLASS_FILESYSTEM);
+	if (!class) {
+		class = &copy->classes[copy->nr_classes - 1];
+		class->id = AUTH_CLASS_FILESYSTEM;
+		class->nbits = AUTH_FS_TEST_RIGHT_80 + 1;
+		class->bits = bitmap_zalloc(class->nbits, GFP_KERNEL);
+		if (!class->bits) {
+			authority_put(copy);
+			return -ENOMEM;
+		}
+	}
+
+	if (check_add_overflow(class->nscopes, 1U, &nr_scopes)) {
+		authority_put(copy);
+		return -EOVERFLOW;
+	}
+	scopes = krealloc_array(class->scopes, nr_scopes,
+				sizeof(*scopes), GFP_KERNEL);
+	if (!scopes) {
+		authority_put(copy);
+		return -ENOMEM;
+	}
+	class->scopes = scopes;
+	scope = &class->scopes[class->nscopes];
+	memset(scope, 0, sizeof(*scope));
+	scope->nbits = AUTH_FS_TEST_RIGHT_80 + 1;
+	scope->rights = bitmap_zalloc(scope->nbits, GFP_KERNEL);
+	if (!scope->rights) {
+		authority_put(copy);
+		return -ENOMEM;
+	}
+	scope->root = *root;
+	path_get(&scope->root);
+	__set_bit(right, scope->rights);
+	/* Test-only sentinel proves scoped entries retain variable-width rights. */
+	__set_bit(AUTH_FS_TEST_RIGHT_80, scope->rights);
+	class->nscopes++;
+
+	*new = copy;
+	return 0;
+}
+
+bool authority_is_subset(const struct authority *subset,
+			 const struct authority *superset)
+{
+	u32 i;
+
+	if (!subset)
+		return !superset || !superset->confined;
+	if (subset->confined && !superset)
+		return false;
+	if (superset && superset->confined && !subset->confined)
+		return false;
+	if (!superset) {
+		for (i = 0; i < subset->nr_classes; i++) {
+			const struct authority_class *class = &subset->classes[i];
+
+			if (!bitmap_empty(class->bits, class->nbits) || class->nscopes)
+				return false;
+		}
+		return true;
+	}
+
+	for (i = 0; i < superset->nr_classes; i++) {
+		const struct authority_class *super = &superset->classes[i];
+		const struct authority_class *sub =
+			authority_find_class(subset, super->id);
+
+		if (super->sealed && (!sub || !sub->sealed))
+			return false;
+		if (super->handled_nbits &&
+		    (!sub || sub->handled_nbits < super->handled_nbits ||
+		     !bitmap_subset(super->handled, sub->handled,
+				    super->handled_nbits)))
+			return false;
+	}
+
+	for (i = 0; i < subset->nr_classes; i++) {
+		const struct authority_class *sub = &subset->classes[i];
+		const struct authority_class *super =
+			authority_find_class(superset, sub->id);
+		unsigned long bit;
+		u32 j;
+
+		for_each_set_bit(bit, sub->bits, sub->nbits)
+			if (!super || bit >= super->nbits ||
+			    !test_bit(bit, super->bits))
+				return false;
+
+		for (j = 0; j < sub->nscopes; j++) {
+			const struct authority_scope *scope = &sub->scopes[j];
+			const struct authority_scope *parent_scope = NULL;
+			u32 k;
+
+			if (!super)
+				return false;
+			for (k = 0; k < super->nscopes; k++)
+				if (authority_same_path(&scope->root,
+							&super->scopes[k].root)) {
+					parent_scope = &super->scopes[k];
+					break;
+				}
+			if (!parent_scope)
+				return false;
+			for_each_set_bit(bit, scope->rights, scope->nbits)
+				if (bit >= parent_scope->nbits ||
+				    !test_bit(bit, parent_scope->rights))
+					return false;
+		}
+	}
+	return true;
+}
+
+static struct authority *authority_clone_or_empty(const struct authority *old)
+{
+	if (old)
+		return authority_clone(old, old->nr_classes, GFP_KERNEL);
+	return authority_clone(NULL, 1, GFP_KERNEL);
+}
+
+int authority_drop_right(const struct authority *old, u32 class_id,
+			u32 right, struct authority **new)
+{
+	struct authority *copy;
+	struct authority_class *class;
+
+	if (!new || !authority_right_supported(class_id, right))
+		return -EINVAL;
+	*new = NULL;
+	class = (struct authority_class *)authority_find_class(old, class_id);
+	if (!class || right >= class->nbits || !test_bit(right, class->bits))
+		return -ENOENT;
+
+	copy = authority_clone_or_empty(old);
+	if (!copy)
+		return -ENOMEM;
+	class = authority_find_class_mut(copy, class_id);
+	__clear_bit(right, class->bits);
+	if (WARN_ON_ONCE(!authority_is_subset(copy, old))) {
+		authority_put(copy);
+		return -EINVAL;
+	}
+	*new = copy;
+	return 0;
+}
+
+int authority_drop_fs_scope_right(const struct authority *old,
+				  const struct path *root, u32 right,
+				  struct authority **new)
+{
+	struct authority *copy;
+	struct authority_class *class;
+	struct authority_scope *scope = NULL;
+	const struct authority_class *old_class;
+	u32 i;
+
+	if (!new || !root || !authority_right_supported(
+			AUTH_CLASS_FILESYSTEM, right))
+		return -EINVAL;
+	*new = NULL;
+	old_class = authority_find_class(old, AUTH_CLASS_FILESYSTEM);
+	if (old_class)
+		for (i = 0; i < old_class->nscopes; i++)
+			if (authority_same_path(root, &old_class->scopes[i].root)) {
+				if (right < old_class->scopes[i].nbits &&
+				    test_bit(right, old_class->scopes[i].rights))
+					break;
+				return -ENOENT;
+			}
+	if (!old_class || i == old_class->nscopes)
+		return -ENOENT;
+
+	copy = authority_clone_or_empty(old);
+	if (!copy)
+		return -ENOMEM;
+	class = authority_find_class_mut(copy, AUTH_CLASS_FILESYSTEM);
+	for (i = 0; i < class->nscopes; i++)
+		if (authority_same_path(root, &class->scopes[i].root)) {
+			scope = &class->scopes[i];
+			break;
+		}
+	__clear_bit(right, scope->rights);
+	if (WARN_ON_ONCE(!authority_is_subset(copy, old))) {
+		authority_put(copy);
+		return -EINVAL;
+	}
+	*new = copy;
+	return 0;
+}
+
+int authority_drop_fs_scope(const struct authority *old,
+			    const struct path *root,
+			    struct authority **new)
+{
+	struct authority *copy;
+	struct authority_class *class;
+	const struct authority_class *old_class;
+	u32 i;
+
+	if (!new || !root)
+		return -EINVAL;
+	*new = NULL;
+	old_class = authority_find_class(old, AUTH_CLASS_FILESYSTEM);
+	if (!old_class)
+		return -ENOENT;
+	for (i = 0; i < old_class->nscopes; i++)
+		if (authority_same_path(root, &old_class->scopes[i].root))
+			break;
+	if (i == old_class->nscopes)
+		return -ENOENT;
+
+	copy = authority_clone_or_empty(old);
+	if (!copy)
+		return -ENOMEM;
+	class = authority_find_class_mut(copy, AUTH_CLASS_FILESYSTEM);
+	path_put(&class->scopes[i].root);
+	bitmap_free(class->scopes[i].rights);
+	memmove(&class->scopes[i], &class->scopes[i + 1],
+		(class->nscopes - i - 1) * sizeof(*class->scopes));
+	class->nscopes--;
+	if (WARN_ON_ONCE(!authority_is_subset(copy, old))) {
+		authority_put(copy);
+		return -EINVAL;
+	}
+	*new = copy;
+	return 0;
+}
+
+#ifdef CONFIG_KUNIT
+#define AUTHORITY_TEST_CLASS_ID 0x7fff0001
+#define AUTHORITY_TEST_OP_IMPLEMENTED 1
+#define AUTHORITY_TEST_OP_UNIMPLEMENTED 2
+
+static bool authority_test_operation_implemented(u32 operation)
+{
+	return operation == AUTHORITY_TEST_OP_IMPLEMENTED;
+}
+
+static int authority_test_evaluate(const struct authority *authority,
+				   const struct authority_request *request)
+{
+	return request->operation == AUTHORITY_TEST_OP_IMPLEMENTED ? 0 :
+		-EOPNOTSUPP;
+}
+
+static struct authority *authority_test_domain(bool sealed,
+					       bool handle_unimplemented)
+{
+	struct authority *authority = authority_alloc(1, GFP_KERNEL);
+	struct authority_class *class;
+
+	if (!authority)
+		return NULL;
+	class = &authority->classes[0];
+	class->id = AUTHORITY_TEST_CLASS_ID;
+	class->nbits = 3;
+	class->bits = bitmap_zalloc(class->nbits, GFP_KERNEL);
+	class->handled_nbits = 3;
+	class->handled = bitmap_zalloc(class->handled_nbits, GFP_KERNEL);
+	if (!class->bits || !class->handled) {
+		authority_destroy(authority);
+		return NULL;
+	}
+	class->sealed = sealed;
+	if (handle_unimplemented)
+		__set_bit(AUTHORITY_TEST_OP_UNIMPLEMENTED, class->handled);
+	authority->confined = true;
+	return authority;
+}
+
+static void authority_core_state_test(struct kunit *test)
+{
+	struct authority_request request = {
+		.class_id = AUTHORITY_TEST_CLASS_ID,
+		.operation = AUTHORITY_TEST_OP_IMPLEMENTED,
+	};
+	struct authority *open_domain, *handled_domain, *sealed_domain, *weakened;
+	struct authority_class *class;
+	struct cred fork_cred = {}, fake_cred = {};
+	enum authority_operation_state state;
+	unsigned int cases = 0, failures = 0;
+	int error;
+
+#define AUTHORITY_EXPECT(condition) do { \
+		bool passed = (condition); \
+		cases++; \
+		if (!passed) \
+			failures++; \
+		KUNIT_EXPECT_TRUE(test, passed); \
+	} while (0)
+
+	request.operation = AUTHORITY_TEST_OP_IMPLEMENTED;
+	error = authority_request_check(NULL, &request, &state);
+	AUTHORITY_EXPECT(!error && state == AUTHORITY_UNHANDLED);
+
+	open_domain = authority_test_domain(false, false);
+	KUNIT_ASSERT_NOT_NULL(test, open_domain);
+	request.operation = AUTHORITY_TEST_OP_UNIMPLEMENTED;
+	error = authority_request_check(&(struct cred){ .authority = open_domain },
+					&request, &state);
+	AUTHORITY_EXPECT(!error && state == AUTHORITY_UNHANDLED);
+
+	handled_domain = authority_test_domain(false, true);
+	KUNIT_ASSERT_NOT_NULL(test, handled_domain);
+	error = authority_request_check(&(struct cred){ .authority = handled_domain },
+					&request, &state);
+	AUTHORITY_EXPECT(error == -EOPNOTSUPP &&
+			 state == AUTHORITY_HANDLED_UNIMPLEMENTED);
+
+	sealed_domain = authority_test_domain(true, false);
+	KUNIT_ASSERT_NOT_NULL(test, sealed_domain);
+	request.operation = AUTHORITY_TEST_OP_IMPLEMENTED;
+	error = authority_request_check(&(struct cred){ .authority = sealed_domain },
+					&request, &state);
+	AUTHORITY_EXPECT(!error && state == AUTHORITY_HANDLED_IMPLEMENTED);
+	request.operation = AUTHORITY_TEST_OP_UNIMPLEMENTED;
+	error = authority_request_check(&(struct cred){ .authority = sealed_domain },
+					&request, &state);
+	AUTHORITY_EXPECT(error == -EOPNOTSUPP &&
+			 state == AUTHORITY_HANDLED_UNIMPLEMENTED);
+	request.operation = 99;
+	error = authority_request_check(&(struct cred){ .authority = sealed_domain },
+					&request, &state);
+	AUTHORITY_EXPECT(error == -EOPNOTSUPP &&
+			 state == AUTHORITY_HANDLED_UNIMPLEMENTED);
+
+	/* A later/absent class is not silently claimed by this domain. */
+	request.class_id = AUTHORITY_TEST_CLASS_ID + 1;
+	request.operation = AUTHORITY_TEST_OP_IMPLEMENTED;
+	error = authority_request_check(&(struct cred){ .authority = sealed_domain },
+					&request, &state);
+	AUTHORITY_EXPECT(!error && state == AUTHORITY_UNHANDLED);
+
+	weakened = authority_clone(sealed_domain, sealed_domain->nr_classes,
+				   GFP_KERNEL);
+	KUNIT_ASSERT_NOT_NULL(test, weakened);
+	class = authority_find_class_mut(weakened, AUTHORITY_TEST_CLASS_ID);
+	class->sealed = false;
+	AUTHORITY_EXPECT(!authority_is_subset(weakened, sealed_domain));
+	authority_put(weakened);
+
+	/* Credential duplication (fork-style) preserves the exact class state. */
+	fork_cred.authority = authority_get(sealed_domain);
+	request.class_id = AUTHORITY_TEST_CLASS_ID;
+	request.operation = AUTHORITY_TEST_OP_UNIMPLEMENTED;
+	error = authority_request_check(&fork_cred, &request, &state);
+	AUTHORITY_EXPECT(error == -EOPNOTSUPP &&
+			 state == AUTHORITY_HANDLED_UNIMPLEMENTED);
+	authority_put(fork_cred.authority);
+
+	/* A credential-changing exec cannot clear an irreversible domain. */
+	fake_cred.authority = authority_get(sealed_domain);
+	authority_cred_clear(&fake_cred);
+	error = authority_request_check(&fake_cred, &request, &state);
+	AUTHORITY_EXPECT(error == -EOPNOTSUPP &&
+			 state == AUTHORITY_HANDLED_UNIMPLEMENTED);
+	authority_put(fake_cred.authority);
+	authority_put(open_domain);
+	authority_put(handled_domain);
+	authority_put(sealed_domain);
+
+	pr_info("AUTH_CORE_TEST_CASES=%u\n", cases);
+	pr_info("AUTH_CORE_TEST_FAILURES=%u\n", failures);
+	pr_info("AUTH_CORE_TEST_EXIT=%u\n", failures ? 1 : 0);
+#undef AUTHORITY_EXPECT
+}
+
+static struct kunit_case authority_core_test_cases[] = {
+	KUNIT_CASE(authority_core_state_test),
+	{}
+};
+
+static struct kunit_suite authority_core_test_suite = {
+	.name = "authority-core",
+	.test_cases = authority_core_test_cases,
+};
+kunit_test_suite(authority_core_test_suite);
+#endif
