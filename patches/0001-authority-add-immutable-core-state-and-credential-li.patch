From c25016c12b05cb6458f96c7bbc09cc3d69d35ea7 Mon Sep 17 00:00:00 2001
From: Eugen <eugen252009@gmail.com>
Date: Sat, 17 Oct 2026 10:21:57 +0200
Subject: [PATCH 1/9] authority: add immutable core state and credential
 lifecycle

Introduce immutable class-dispatched Authority state and filesystem scope evaluation, credential reference ownership and exec transitions. Keep the embedded synthetic KUnit class/tests with their private implementation rather than manufacturing a split. Wire Core through existing unconditional Kbuild integration. No public constructor is exposed until the pathname integration commit.
---
 fs/exec.c                    |   21 +-
 include/linux/authority.h    |  110 ++++
 include/linux/cred.h         |    3 +
 init/init_task.c             |    1 +
 kernel/Makefile              |    2 +-
 kernel/authority.c           | 1047 ++++++++++++++++++++++++++++++++++
 kernel/cred.c                |    4 +
 security/keys/process_keys.c |    3 +
 8 files changed, 1189 insertions(+), 2 deletions(-)
 create mode 100644 include/linux/authority.h
 create mode 100644 kernel/authority.c

diff --git a/fs/exec.c b/fs/exec.c
index a5269b5e00df1ceff0e437dacd921c796cb78ba2..2800fb0d8ec9a8829786a92e32c7fc0aaa04f1bc 100644
--- a/fs/exec.c
+++ b/fs/exec.c
@@ -53,6 +53,9 @@
 #include <linux/namei.h>
 #include <linux/mount.h>
 #include <linux/security.h>
+#include <linux/cred.h>
+#include <linux/capability.h>
+#include <linux/authority.h>
 #include <linux/syscalls.h>
 #include <linux/tsacct_kern.h>
 #include <linux/cn_proc.h>
@@ -1699,9 +1702,25 @@ static int bprm_creds_from_file(struct linux_binprm *bprm)
 {
 	/* Compute creds based on which file? */
 	struct file *file = bprm->execfd_creds ? bprm->executable : bprm->file;
+	const struct cred *old = current_cred();
+	int ret;
 
 	bprm_fill_uid(bprm, file);
-	return security_bprm_creds_from_file(bprm, file);
+	ret = security_bprm_creds_from_file(bprm, file);
+	if (ret)
+		return ret;
+
+	/* A credential-changing (e.g. setid/file-capability) exec drops PoC authority. */
+	if (!uid_eq(old->uid, bprm->cred->uid) ||
+	    !uid_eq(old->euid, bprm->cred->euid) ||
+	    !gid_eq(old->gid, bprm->cred->gid) ||
+	    !gid_eq(old->egid, bprm->cred->egid) ||
+	    !cap_issubset(old->cap_permitted, bprm->cred->cap_permitted) ||
+	    !cap_issubset(bprm->cred->cap_permitted, old->cap_permitted) ||
+	    !cap_issubset(old->cap_effective, bprm->cred->cap_effective) ||
+	    !cap_issubset(bprm->cred->cap_effective, old->cap_effective))
+		authority_cred_clear(bprm->cred);
+	return 0;
 }
 
 /*
diff --git a/include/linux/authority.h b/include/linux/authority.h
new file mode 100644
index 0000000000000000000000000000000000000000..0e7329e10799599d132c30fbbe28d6085dacb6e3
--- /dev/null
+++ b/include/linux/authority.h
@@ -0,0 +1,110 @@
+/* SPDX-License-Identifier: GPL-2.0 */
+#ifndef _LINUX_AUTHORITY_H
+#define _LINUX_AUTHORITY_H
+
+#include <linux/types.h>
+#include <linux/gfp_types.h>
+
+struct cred;
+struct path;
+struct authority;
+
+/* Class and right identifiers are kernel-internal, not bitmap ABI positions. */
+enum authority_class_id {
+	AUTH_CLASS_FILESYSTEM = 1,
+};
+
+enum authority_fs_access {
+	AUTH_FS_ACCESS_READ = 1,
+	AUTH_FS_ACCESS_WRITE = 2,
+};
+
+/* Operation IDs are class-local; legacy filesystem right IDs remain separate. */
+enum authority_fs_operation {
+	AUTH_FS_OP_CREATE_FILE = 1,
+	AUTH_FS_OP_TRAVERSE = 2,
+	AUTH_FS_OP_READ_FILE = 3,
+	AUTH_FS_OP_WRITE_FILE = 4,
+	AUTH_FS_OP_DELETE_FILE = 5,
+	AUTH_FS_OP_RENAME = 6,
+	AUTH_FS_OP_LINK = 7,
+};
+
+enum authority_operation_state {
+	AUTHORITY_UNHANDLED,
+	AUTHORITY_HANDLED_IMPLEMENTED,
+	AUTHORITY_HANDLED_UNIMPLEMENTED,
+};
+
+/* Borrowed, synchronous, tagged request context. Class owns its semantics. */
+struct authority_request {
+	u32 class_id;
+	u32 operation;
+	union {
+		struct {
+			const struct path *path;
+		} filesystem;
+	} context;
+};
+
+enum authority_fs_right {
+	AUTH_FS_DAC_OVERRIDE = 0,
+	AUTH_FS_CREATE_FILE = 1,
+	AUTH_FS_TRAVERSE = 2,
+	AUTH_FS_READ_FILE = 3,
+	AUTH_FS_WRITE_FILE = 4,
+	AUTH_FS_DELETE_FILE = 5,
+	AUTH_FS_RENAME = 6,
+	AUTH_FS_LINK = 7,
+	/* Non-authorizing sentinel used to exercise variable-width storage. */
+	AUTH_FS_TEST_RIGHT_80 = 80,
+};
+
+struct authority *authority_create_fs_poc(gfp_t gfp);
+int authority_enter_confined(const struct authority *old,
+			     const unsigned long *handled,
+			     u32 handled_nbits,
+			     struct authority **new);
+bool authority_is_confined(const struct cred *cred);
+int authority_request_check(const struct cred *cred,
+			    const struct authority_request *request,
+			    enum authority_operation_state *state);
+int authority_fs_operation_check(const struct cred *cred,
+				const struct path *path,
+				enum authority_fs_operation operation);
+bool authority_fs_right_handled(const struct cred *cred,
+				enum authority_fs_right right);
+bool authority_fs_access_handled(const struct cred *cred, u32 access);
+int authority_add_fs_scope(const struct authority *old,
+			   const struct path *root, u32 right,
+			   struct authority **new);
+int authority_has_scoped_right(const struct authority *authority,
+			       const struct path *path, u32 class_id,
+			       u32 right, bool *has_right);
+bool authority_allows_fs_exact(const struct cred *cred,
+			       const struct path *path,
+			       enum authority_fs_right right);
+bool authority_allows_fs(const struct cred *cred, const struct path *path,
+			 enum authority_fs_right right);
+bool authority_allows_fs_access(const struct cred *cred,
+				const struct path *path, u32 access);
+int authority_fs_access_ceiling_check(const struct cred *cred,
+				      const struct path *path, u32 access);
+int authority_drop_fs_scope_right(const struct authority *old,
+				  const struct path *root, u32 right,
+				  struct authority **new);
+int authority_drop_fs_scope(const struct authority *old,
+			    const struct path *root,
+			    struct authority **new);
+struct authority *authority_get(struct authority *authority);
+void authority_put(struct authority *authority);
+void authority_cred_replace(struct cred *cred, struct authority *authority);
+void authority_cred_clear(struct cred *cred);
+int authority_has_right(const struct authority *authority, u32 class_id,
+			u32 right, bool *has_right);
+int authority_drop_right(const struct authority *old, u32 class_id,
+			u32 right, struct authority **new);
+bool authority_is_subset(const struct authority *subset,
+			 const struct authority *superset);
+
+#endif /* _LINUX_AUTHORITY_H */
