+static int prctl_capauth_scope(unsigned long operation,
+			       unsigned long fd_arg, unsigned long right_arg)
+{
+	struct authority *updated;
+	struct cred *new;
+	struct fd f;
+	struct file *file;
+	int ret;
+
+	if (fd_arg > INT_MAX || right_arg > U32_MAX)
+		return -EINVAL;
+	if (operation == PR_CAPAUTH_ADD_FS_SCOPE &&
+	    !capable(CAP_SYS_ADMIN))
+		return -EPERM;
+
+	/* Scope handles are commonly O_PATH directory descriptors. */
+	f = fdget_raw((unsigned int)fd_arg);
+	if (fd_empty(f))
+		return -EBADF;
+	file = fd_file(f);
+
+	if (operation == PR_CAPAUTH_ADD_FS_SCOPE &&
+	    (!file_inode(file) || !S_ISDIR(file_inode(file)->i_mode))) {
+		ret = -ENOTDIR;
+		goto out_fd;
+	}
+
+	if (operation == PR_CAPAUTH_HAS_SCOPED_RIGHT) {
+		bool has_right;
+
+		ret = authority_has_scoped_right(current_cred()->authority,
+						 &file->f_path,
+						 AUTH_CLASS_FILESYSTEM,
+						 right_arg, &has_right);
+		if (!ret)
+			ret = has_right;
+		goto out_fd;
+	}
+
+	new = prepare_creds();
+	if (!new) {
+		ret = -ENOMEM;
+		goto out_fd;
+	}
+
+	switch (operation) {
+	case PR_CAPAUTH_ADD_FS_SCOPE:
+		ret = authority_add_fs_scope(new->authority, &file->f_path,
+					     right_arg, &updated);
+		break;
+	case PR_CAPAUTH_DROP_FS_SCOPE_RIGHT:
+		ret = authority_drop_fs_scope_right(new->authority,
+						    &file->f_path,
+						    right_arg, &updated);
+		break;
+	case PR_CAPAUTH_DROP_FS_SCOPE:
+		ret = authority_drop_fs_scope(new->authority, &file->f_path,
+					      &updated);
+		break;
+	default:
+		ret = -EINVAL;
+		break;
+	}
+	if (ret) {
+		abort_creds(new);
+		goto out_fd;
+	}
+
+	authority_cred_replace(new, updated);
+	ret = commit_creds(new);
+out_fd:
+	fdput(f);
+	return ret;
+}
