+static enum legacy_dac_provider_result
+legacy_dac_regular_file_provider(const struct fs_access_request *request,
+				 u32 operation, int *provider_error)
+{
+	int mask = request->permission_mask;
+
+	if (operation == AUTH_FS_ACCESS_READ ||
+	    operation == AUTH_FS_ACCESS_WRITE) {
+		mask &= ~(MAY_READ | MAY_WRITE);
+		mask |= operation == AUTH_FS_ACCESS_READ ? MAY_READ : MAY_WRITE;
