+
+static int fs_access_decide_one(const struct fs_access_request *request,
+				u32 operation,
+				enum legacy_dac_provider_result legacy,
+				int provider_error)
+{
+	enum authority_fs_right right;
+	bool explicit_allow, mandatory;
+
+	right = operation == AUTH_FS_ACCESS_READ ? AUTH_FS_READ_FILE :
+		AUTH_FS_WRITE_FILE;
+	if (legacy == LEGACY_DAC_PROVIDER_NOT_APPLICABLE)
+		return provider_error;
