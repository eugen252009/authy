+/*
+ * A created struct file is a new bearer capability. In a confined domain,
+ * CREATE authorizes object instantiation, but the requested initial data
+ * access must independently be covered by scopes for handled READ/WRITE.
+ * Unhandled data operations retain Linux's creation semantics. Existing
+ * directory scopes already cover future descendants; no grant is inherited
+ * or synthesized from CREATE itself.
+ */
+static int may_open_created_access(const struct path *path, int acc_mode)
+{
+	if (!authority_is_confined(current_cred()))
+		return 0;
+	if ((acc_mode & MAY_READ) &&
+	    authority_fs_right_handled(current_cred(), AUTH_FS_READ_FILE) &&
+	    !authority_allows_fs(current_cred(), path, AUTH_FS_READ_FILE))
+		return -EACCES;
+	if ((acc_mode & MAY_WRITE) &&
+	    authority_fs_right_handled(current_cred(), AUTH_FS_WRITE_FILE) &&
+	    !authority_allows_fs(current_cred(), path, AUTH_FS_WRITE_FILE))
+		return -EACCES;
+	return 0;
+}
