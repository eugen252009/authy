+static int prctl_capauth_confine(unsigned long arg)
+{
+	struct pr_capauth_confine header;
+	struct authority *updated;
+	struct authority *old = current_cred()->authority;
+	struct cred *new;
+	unsigned long *handled;
+	u8 __user *user_bitmap;
+	size_t bytes;
+	unsigned long bit;
+	int error;
+
+	if (copy_from_user(&header, (void __user *)arg, sizeof(header)))
+		return -EFAULT;
+	if (header.version != PR_CAPAUTH_CONFINE_VERSION_1 || header.flags ||
+	    header.reserved || header.reserved2)
+		return -EINVAL;
+	if (header.size < sizeof(header) + 1)
+		return -EINVAL;
+	if (header.size > PAGE_SIZE)
+		return -E2BIG;
+	if (!thread_group_empty(current))
+		return -EBUSY;
+	if (authority_is_confined(current_cred()))
+		return -EALREADY;
+
+	bytes = header.size - sizeof(header);
+	user_bitmap = (u8 __user *)arg + sizeof(header);
+	handled = bitmap_zalloc(AUTH_FS_TEST_RIGHT_80 + 1, GFP_KERNEL);
+	if (!handled)
+		return -ENOMEM;
+	{
+		u8 *request = memdup_user(user_bitmap, bytes);
+
+		if (IS_ERR(request)) {
+			error = PTR_ERR(request);
+			goto out_bitmap;
+		}
+		for (bit = 0; bit < bytes * 8; bit++) {
+			if (!(request[bit / 8] & BIT(bit % 8)))
+				continue;
+			switch (bit) {
+			/* These legacy bitmap positions select class-local operations. */
+			case AUTH_FS_OP_CREATE_FILE:
+			case AUTH_FS_OP_READ_FILE:
+			case AUTH_FS_OP_WRITE_FILE:
+			case AUTH_FS_OP_DELETE_FILE:
+			case AUTH_FS_OP_RENAME:
+			case AUTH_FS_OP_LINK:
+				__set_bit(bit, handled);
+				break;
+			default:
+				error = -EOPNOTSUPP;
+				kfree(request);
+				goto out_bitmap;
+			}
+		}
+		kfree(request);
+	}
+
+	new = prepare_creds();
+	if (!new) {
+		error = -ENOMEM;
+		goto out_bitmap;
+	}
+	error = authority_enter_confined(old, handled,
+					AUTH_FS_TEST_RIGHT_80 + 1, &updated);
+	if (error) {
+		abort_creds(new);
+		goto out_bitmap;
+	}
+	authority_cred_replace(new, updated);
+	error = commit_creds(new);
+	if (!error)
+		task_set_no_new_privs(current);
+out_bitmap:
+	bitmap_free(handled);
+	return error;
