+
+static bool fs_access_request_supported(const struct fs_access_request *request)
+{
+	int access_mask = 0;
+
+	if (request->operations & AUTH_FS_ACCESS_READ)
+		access_mask |= MAY_READ;
+	if (request->operations & AUTH_FS_ACCESS_WRITE)
+		access_mask |= MAY_WRITE;
+	if (!access_mask ||
+	    request->operations & ~(AUTH_FS_ACCESS_READ | AUTH_FS_ACCESS_WRITE) ||
+	    (request->permission_mask & (MAY_READ | MAY_WRITE)) != access_mask ||
+	    (request->permission_mask & (MAY_EXEC | MAY_NOT_BLOCK)))
+		return false;
+	return true;
+}
+
+static int fs_regular_file_access_decision(
+		const struct fs_access_request *request,
+		bool *generic_dac_denied)
+{
+	enum legacy_dac_provider_result legacy;
+	int provider_error, error;
+
+	/* Preserve the common fast path: one ordinary generic DAC evaluation. */
+	legacy = legacy_dac_regular_file_provider(request, 0, &provider_error);
+	if (legacy == LEGACY_DAC_PROVIDER_NOT_APPLICABLE)
+		return provider_error;
+	if (legacy == LEGACY_DAC_PROVIDER_ALLOW)
+		return 0;
+	if (generic_dac_denied)
+		*generic_dac_denied = true;
+
+	/*
+	 * Only a generic DAC denial needs per-operation composition. This lets
+	 * O_RDWR combine DAC for one operation with explicit authority for the
+	 * other without changing the ordinary aggregate-DAC success path.
+	 */
+	if (request->operations == AUTH_FS_ACCESS_READ)
+		return fs_access_decide_one(request, AUTH_FS_ACCESS_READ,
+					    legacy, provider_error);
+	if (request->operations == AUTH_FS_ACCESS_WRITE)
+		return fs_access_decide_one(request, AUTH_FS_ACCESS_WRITE,
+					    legacy, provider_error);
+
+	legacy = legacy_dac_regular_file_provider(request, AUTH_FS_ACCESS_READ,
+						  &provider_error);
+	error = fs_access_decide_one(request, AUTH_FS_ACCESS_READ, legacy,
+				     provider_error);
+	if (error)
+		return error;
+	legacy = legacy_dac_regular_file_provider(request, AUTH_FS_ACCESS_WRITE,
+						  &provider_error);
+	return fs_access_decide_one(request, AUTH_FS_ACCESS_WRITE, legacy,
+				    provider_error);
+}
